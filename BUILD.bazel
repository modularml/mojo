string_flag(
    name = "mojo_base_version",
    build_setting_default = "1.1.0",
    make_variable = "MOJO_BASE_VERSION",
)

# The base versions are 'stable', while the labels change frequently.
string_flag(
    name = "max_version_label",
    build_setting_default = ".dev0",
    make_variable = "MAX_VERSION_LABEL",
)

string_flag(
    name = "mojo_version_label",
    build_setting_default = ".dev0",
    make_variable = "MOJO_VERSION_LABEL",
)

string_flag(
    name = "modular_version_sha",
    build_setting_default = "deadbeef",
)

bool_flag(
    name = "use_prebuilt_mojo_toolchain",
    build_setting_default = True,
    tags = [ALLOW_UNUSED_TAG],
)

config_setting(
    name = "use_prebuilt_mojo_toolchain_disabled",
    flag_values = {":use_prebuilt_mojo_toolchain": "false"},
    tags = [ALLOW_UNUSED_TAG],
)

[
    config_setting(
        name = name + "_prebuilt_mojo_toolchain_enabled",
        constraint_values = constraints,
        flag_values = {":use_prebuilt_mojo_toolchain": "true"},
        # Only used in OSS build
        tags = ["maybe-unused"],
    )
    for name, constraints in [
        (
            "linux_x86_64",
            [
                "@platforms//cpu:x86_64",
                "@platforms//os:linux",
            ],
        ),
        (
            "linux_aarch64",
            [
                "@platforms//cpu:aarch64",
                "@platforms//os:linux",
            ],
        ),
        (
            "macos",
            ["@platforms//os:macos"],
        ),
    ]
]

config_setting(
    name = "linux_x86_64",
    constraint_values = [
