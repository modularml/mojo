load("//bazel:api.bzl", "mojo_filecheck_test", "mojo_test")
load("//max/kernels/src:deprecations.bzl", "IGNORED_POINTER_DEPRECATIONS_COPTS")

package(default_visibility = ["//max:consumers"])

_FILECHECK_TESTS = [
    "test_memory.mojo",
    "test_sharedmem_async_cp.mojo",
    "test_tma_ops.mojo",
]

_OTHER_TESTS = [
    "test_shared_mem_barrier.mojo",
    "test_async_cpy_wait_group.mojo",
    "test_buffer_io.mojo",
    "test_copy_async.mojo",
    "test_cp_async_bulk.mojo",
    "test_ldg_intrinsics.mojo",
    "test_ldmatrix_fp8.mojo",
    "test_load_cache.mojo",
    "test_semaphore_reduction.mojo",
    "test_tma.mojo",
    "test_tcgen05.mojo",
    "test_tma_block_reduce.mojo",
    "test_tma_gather4.mojo",
]

_EXTRA_CONSTRAINTS = {
    "test_apple_edge_masked_load.mojo": ["//:apple_gpu"],
}

mojo_filecheck_test(
    name = "test_shared_mem_barrier.mojo.test",
    srcs = ["test_shared_mem_barrier.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    enable_assertions = False,
    tags = ["gpu"],
    target_compatible_with = ["//:has_gpu"],
    deps = [
        "//max:layout",
        "//max:linalg",
        "@mojo//:std",
    ],
)

# Most filecheck tests can run on any GPU
[
    mojo_filecheck_test(
        name = src + ".test",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"],
        deps = [
            "//max:layout",
            "//max:linalg",
            "@mojo//:std",
        ],
    )
    for src in _FILECHECK_TESTS
    if src != "test_sharedmem_async_cp.mojo"
]

# test_sharedmem_async_cp uses NVIDIA-specific mbarrier and time.sleep() in GPU kernel
mojo_filecheck_test(
    name = "test_sharedmem_async_cp.mojo.test",
    srcs = ["test_sharedmem_async_cp.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = [
        "gpu",
        "manual",
    ],  # TODO: KERN-1531 hangs with regular builds
    target_compatible_with = ["//:nvidia_gpu"],
    deps = [
        "//max:layout",
        "//max:linalg",
        "@mojo//:std",
    ],
)

[
    mojo_test(
        name = src + ".test",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        exec_properties = {
            "test.resources:gpu-memory": "1",
        },
        tags = ["gpu"],
        target_compatible_with = ["//:nvidia_gpu"],
        deps = [
            "//max:layout",
            "//max:linalg",
            "@mojo//:std",
        ],
    )
    for src in [
        "test_async_cpy_wait_group.mojo",
        "test_ldg_intrinsics.mojo",
        "test_copy_async.mojo",
        "test_semaphore_reduction.mojo",  # FIXME: KERN-1377 and move to the globbed mojo_test
        "test_load_cache.mojo",  # FIXME: KERN-1377 and move to the globbed mojo_test
    ]
]

mojo_test(
    name = "test_buffer_io.mojo.test",
    srcs = ["test_buffer_io.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = ["gpu"],
    target_compatible_with = ["//:amd_gpu"],
    deps = [
        "//max:layout",
        "//max:linalg",
        "@mojo//:std",
    ],
)

mojo_test(
    name = "test_ldmatrix_fp8.mojo.test",
    srcs = ["test_ldmatrix_fp8.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = ["gpu"],
    target_compatible_with = ["//:h100_gpu"],
    deps = [
        "//max:layout",
        "//max:linalg",
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

_B200_GPU_MEMORY = {
    "test_tcgen05.mojo": "2",
}

_B200_EXTRA_DEPS = {
    "test_tcgen05.mojo": ["//max:max_mojo"],
}

[
    mojo_test(
        name = src + ".test",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        exec_properties = {
            "test.resources:gpu-memory": _B200_GPU_MEMORY.get(src, "1"),
        },
        tags = ["gpu"],
        target_compatible_with = ["//:b200_gpu"],
        deps = [
            "//max:layout",
            "//max:linalg",
            "@mojo//:std",
        ] + _B200_EXTRA_DEPS.get(src, []),
    )
    for src in [
        "test_cp_async_bulk.mojo",
        "test_tcgen05.mojo",
    ]
]

mojo_test(
    name = "test_tma_gather4.mojo.test",
    srcs = ["test_tma_gather4.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    exec_properties = {"test.resources:gpu-memory": "1"},
    tags = ["gpu"],
    target_compatible_with = ["//:b200_gpu"],
    deps = [
        "//max:kv_cache",
        "//max:layout",
        "//max:linalg",
        "//max:nn",
        "@mojo//:std",
    ],
)

mojo_test(
    name = "test_tma_block_reduce.mojo.test",
    srcs = ["test_tma_block_reduce.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = ["gpu"],
    target_compatible_with = select({
        "//:h100_gpu": [],
        "//:b200_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//max:layout",
        "//max:linalg",
        "@mojo//:std",
    ],
)

mojo_filecheck_test(
    name = "test_tma.mojo.test",
    srcs = ["test_tma.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = ["gpu"],
    target_compatible_with = ["//:h100_gpu"],
    deps = [
        "//max:layout",
        "//max:linalg",
        "@mojo//:std",
    ],
)

_GLOB_GPU_MEMORY = {
    "test_external_memory_callee_patterns.mojo": "1",
}

[
    mojo_test(
        name = src + ".test",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        exec_properties = {
            "test.resources:gpu-memory": _GLOB_GPU_MEMORY.get(src, "1"),
        },
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + _EXTRA_CONSTRAINTS.get(src, []),
        deps = [
            "//max:layout",
            "//max:linalg",
            "@mojo//:std",
        ],
    )
    for src in glob(
        ["**/*.mojo"],
        exclude = _FILECHECK_TESTS + _OTHER_TESTS,
    )
]
