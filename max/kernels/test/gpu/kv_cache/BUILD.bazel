# test_paged_kv_null_block_sentinel.mojo
# Regression test for CUDA_ERROR_ILLEGAL_ADDRESS (SERVOPT-1456).
# Verifies that `populate` with LUT tail-padding filled with `total_num_pages`
# (the null-block index) returns in-bounds row indices on the N+1 allocation.
# Complements the Python-layer test in test_kv_cache_manager.py.
mojo_test(
    name = "test_paged_kv_null_block_sentinel.mojo.test",
