# Row-major (page-dense) K/V is now the constructor default for the multi-page
# paging regime (0 < page_size < BN); it is no longer a compile-time define.
# The base paged targets below therefore exercise the row-major path directly
# for the engaging configs (single-CTA, head_size=128, ps16/ps64 < BN=128),
# validated against the in-kernel naive reference; ps128/ps256 (>= BN) cover the
# chunk-outer path. The former `-D row_major_*` A/B variants were dropped along
# with the defines, as were the `_pair_cta` variants -- ps128/ps256 keep the
# chunk-outer path covered without them.

# All paged-FA test variants share one source
# (test_batch_kv_cache_flash_attention_causal_mask_ragged_paged.mojo), so they
# are emitted from a SINGLE mojo_test() call site below -- otherwise that source
# is referenced from multiple rule locations and trips
# bazel/internal/find_duplicate_srcs.py (each list comprehension counts as a
# distinct location).
[
    mojo_test(
        name = "test_batch_kv_cache_flash_attention_causal_mask_ragged_paged_ps{}_hs{}.mojo.test".format(
            page_size,
            head_size,
        ),
        size = "large",
        srcs = [
            "kv_cache_test_utils.mojo",
            "test_batch_kv_cache_flash_attention_causal_mask_ragged_paged.mojo",
        ],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS + [
            "-D",
            "page_size={}".format(page_size),
            "-D",
            "head_size={}".format(head_size),
        ],
        enable_assertions = select({
            "//:b200_gpu": True,
            "//conditions:default": False,  # KERN-2339
        }),
        exec_properties = {
            "test.resources:gpu-memory": _PAGED_FA_GPU_MEMORY.get(
                (page_size, head_size),
                "6",
            ),
        },
        main = "test_batch_kv_cache_flash_attention_causal_mask_ragged_paged.mojo",
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + constraints,
        deps = [
            "//max:internal_utils",
            "//max:kv_cache",
            "//max:linalg",
            "//max:nn",
            "//max:quantization",
            "@mojo//:std",
        ],
    )
    for page_size, head_size, constraints in _PAGED_FA_CONFIGS
]

# PAQ-2333 / KERN-2734: mixed TG+CE ragged paged batch on Gemma3 27B shapes
# (230 TG + 40 CE, 270 requests) that production hit as an FA4 TMA transaction
# barrier deadlock. This ran as "manual" for a long time on the belief that it
# reproduced that deadlock; it did not -- it oversubscribed its own KV block
# pool and died in host setup before any launch (see the `num_blocks` note in
# the test). With the pool sized to the batch it passes, so it runs in CI as a
# hang/NaN regression gate for this shape mix. Passing here is NOT evidence
# that the TMA deadlock class is fixed -- the repro never reached the kernel,
# so no commit exists at which it both passed and exercised FA4.
#
# B200-only: the deadlock under test is SM100 FA4, and page_size=64 cannot
# build on gfx950 at all -- the AMD decode path instantiates tile_size=128 and
# `PagedKVCache` rejects a tile wider than the page (kv_cache/types.mojo).
[
    mojo_test(
        name = "test_mha_inflight_batching_gemma3_hang_ps{}.mojo.test".format(page_size),
        size = "large",
        srcs = [
            "kv_cache_test_utils.mojo",
            "test_mha_inflight_batching_gemma3_hang.mojo",
        ],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS + [
            "-D",
            "page_size={}".format(page_size),
        ],
        enable_assertions = True,
        exec_properties = {
            "test.resources:gpu-memory": "8",
        },
        main = "test_mha_inflight_batching_gemma3_hang.mojo",
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + select({
            "//:b200_gpu": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "//max:internal_utils",
            "//max:kv_cache",
            "//max:linalg",
            "//max:nn",
            "//max:quantization",
            "@mojo//:std",
        ],
    )
    for page_size in (64, 128, 256)
]

