load("//bazel:api.bzl", "mojo_test")
load("//max/kernels/src:deprecations.bzl", "IGNORED_POINTER_DEPRECATIONS_COPTS")

package(default_visibility = ["//max:consumers"])

# Special configuration for multimem allreduce test - only runs on SM90+ hardware
mojo_test(
    name = "test_multimem_allreduce.mojo.test",
    size = "large",
    srcs = [
        "test_allreduce.mojo",
        "test_multimem_allreduce.mojo",
    ],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    exec_properties = {
        "test.resources:gpu-memory": "4",
    },
    main = "test_multimem_allreduce.mojo",
    tags = ["gpu"],
    target_compatible_with = select({
        "//:h100_gpu": ["//:has_multi_gpu"],
        "//:b200_gpu": ["//:has_multi_gpu"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//max:internal_utils",
        "//max:kv_cache",
        "//max:linalg",
        "//max:nn",
        "//max:quantization",
        "@mojo//:std",
    ],
)

# Special configuration for multimem reducescatter test - only runs on SM90+ hardware
mojo_test(
    name = "test_multimem_reducescatter.mojo.test",
    size = "large",
    srcs = [
        "test_multimem_reducescatter.mojo",
        "test_reducescatter.mojo",
    ],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    exec_properties = {
        "test.resources:gpu-memory": "4",
    },
    main = "test_multimem_reducescatter.mojo",
    tags = ["gpu"],
    target_compatible_with = select({
        "//:h100_gpu": ["//:has_multi_gpu"],
        "//:b200_gpu": ["//:has_multi_gpu"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//max:internal_utils",
        "//max:kv_cache",
        "//max:linalg",
        "//max:nn",
        "//max:quantization",
        "@mojo//:std",
    ],
)

_GPU_MEMORY = {
    "test_p2p_ep_combine.mojo": "25",
    "test_p2p_ep_dispatch.mojo": "25",
    "test_allreduce_residual_rmsnorm_fp8.mojo": "9",
    "test_p2p_copy.mojo": "5",
}

# Tests where assertions push register usage past hardware limits,
# causing CUDA_ERROR_LAUNCH_OUT_OF_RESOURCES on NVIDIA GPUs.
DISABLE_ASSERTIONS_TESTS = []

# Standalone multi-GPU test: allreduce + RMSNorm + FP8 quantization.
# Needs multi-GPU constraints, disabled assertions, special env vars,
# 4GB GPU memory, and extra deps that the standard comm glob doesn't provide.
mojo_test(
    name = "test_allreduce_residual_rmsnorm.mojo.test",
    size = "large",
    srcs = ["test_allreduce_residual_rmsnorm.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    enable_assertions = False,  # MSTDL-2301: register pressure
    exec_properties = {
        "test.resources:gpu-memory": "4",
    },
    tags = ["gpu"],
    target_compatible_with = [
        "//:has_gpu",
        "//:has_multi_gpu",
    ],
    deps = [
        "//max:comm",
        "//max:internal_utils",
        "//max:kv_cache",
        "//max:linalg",
        "//max:nn",
        "//max:quantization",
        "//max:shmem",
        "@mojo//:std",
    ],
)

# Regular tests for all other files
[
    mojo_test(
        name = src + ".test",
        size = "medium",  # MI355s only need small
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        enable_assertions = src not in DISABLE_ASSERTIONS_TESTS,
        exec_properties = {
            "test.resources:gpu-memory": _GPU_MEMORY.get(src, "6"),
        },
        main = src,
        tags = ["gpu"],
        target_compatible_with = [
            "//:has_gpu",
            "//:has_multi_gpu",
        ],
        deps = [
            "//max:internal_utils",
            "//max:kv_cache",
            "//max:linalg",
            "//max:max_mojo",
            "//max:nn",
            "//max:quantization",
            "//max:shmem",
            "@mojo//:std",
        ],
    )
    for src in glob(
        ["**/*.mojo"],
        exclude = [
            "test_multimem_allreduce.mojo",
            "test_multimem_reducescatter.mojo",
            "test_allreduce_residual_rmsnorm.mojo",  # Has its own standalone rule above
        ],
    )
]
