        }),
        exec_properties = {
            "test.resources:gpu-memory": _GPU_MEMORY.get(src, "4"),
        },
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + _EXTRA_CONSTRAINTS.get(src, []),
        deps = [
            "//max:internal_utils",
