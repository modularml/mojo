    # "256",  # QUA-777 / KERN-3237: disabled due to nondeterminism
    # "128",  # QUA-777 / KERN-3237: disabled due to nondeterminism
    # Re-enable tracking: https://linear.app/modularml/issue/KERN-3237
    # "64",  # QUA-375 / KERN-2912: disabled due to nondeterminism
]

[
    mojo_test(
        name = "test_mla_decode_paged_variable_ps{}.mojo.test".format(page_size),
