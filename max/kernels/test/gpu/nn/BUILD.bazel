# WINDOWED masks (chunked / sliding-window) at depth 128, swept over
# P{1,2,4,6,8,10} (6 and 10 are the non-pow2 cluster sizes).
# RESOLVED (#36 windowed@128, 2026-06-23): these mismatched vs `mha_gpu_naive`
# (chunked 0.866, SW 0.043) until the depth-128 split-K combine bug was fixed.
# Root cause was NOT empty-partitions or bf16 tolerance: `fa4_splitk_combine_write`
# held its combined-O register fragment `o_final` for only ONE depth-column
# (`reg_frag_len`), but at depth 128 `iters_total == 2`. Its Phase A reads ALL
# columns into registers before Phase B writes bf16 (mandatory: the f32 stage
# aliases the bf16 output), so the second column's `accumulate` clobbered the
# first, and Phase B wrote the LAST column into BOTH gmem depth blocks -> gmem
# depth [0,64) received depth [64,128)'s values. It hid on null/causal because
# averaging over all 1026 keys makes O ~ 0 (block0 ~ block1, ~0.039 < atol); the
# few-key chunked mask (O large) exposed it at 0.866. Fix: size `o_final` =
# `reg_frag_len * iters_per_wg` + column-index accumulate/write_to_smem
# (byte-identical at depth 64 where iters_per_wg == 1). All committed now.
[
    mojo_test(
        name = "attention/test_mha_sm100_1q_splitk_combine_{}_d128_p{}.mojo.test".format(
            cfg[0],
            cfg[1],
        ),
        size = "large",
        srcs = ["attention/test_mha_sm100_1q_splitk_lse.mojo"],
        # Shape-driven P (cache = 512 * P => floor_pow2(cache//512) == P). At P=8
        # the windowed mask still leaves trailing partitions empty (active tiles
        # < P), so the M6 empty-partition + windowed-d128 combine path is covered.
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS + [
            "-D",
            "FA4_1Q_SPLITK_CACHE={}".format(512 * cfg[1]),
            "-D",
            "FA4_1Q_SPLITK_MASK={}".format(cfg[2]),
            "-D",
            "FA4_1Q_SPLITK_DEPTH=128",
        ],
        exec_properties = {
            "test.resources:gpu-memory": "3",
        },
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + select({
            "//:b200_gpu": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
