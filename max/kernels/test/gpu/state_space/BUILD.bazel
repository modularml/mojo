# The SM100 KDA ports carry the reference instruction stream; ASSERT=all
# injects bounds-check printf machinery into their 512/1024-thread kernels
# and spills them to local memory, so these targets opt out.
_NO_ASSERTS = [
    "test_sm100_kda_prefill_m64.mojo",
    "test_sm100_kda_prefill_m128.mojo",
    "test_sm100_kda_bt16.mojo",
    "test_kda_glm53_flash.mojo",
    "bench_sm100_kda_prefill_m128.mojo",
    "bench_sm100_kda_prefill_m64.mojo",
    "bench_sm100_kda_bt16.mojo",
]

[
    mojo_test(
        name = src + ".test",
        size = "large",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        enable_assertions = src not in _NO_ASSERTS,
        exec_properties = {
            "test.resources:gpu-memory": _GPU_MEMORY.get(src, "2"),
        },
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + _EXTRA_CONSTRAINTS.get(src, []),
        deps = _KDA_DEPS.get(src, []) + [
            "//max:internal_utils",
            "//max:linalg",
            "//max:testdata",
            "//max/kernels/src/state_space",
            "@mojo//:std",
        ],
    )
    for src in glob(["**/*.mojo"])
]
