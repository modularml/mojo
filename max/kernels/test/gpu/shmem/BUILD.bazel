# Single-GPU (gfx950) regression guard for the EP-combine device-scope
# data-ready acquire fence. Pure std (no rocshmem runtime): a NaN-poisoned,
# oversubscribed producer/consumer handoff that reads stale ~55% of the time if
# the fence is missing, and 0 with it.
mojo_test(
    name = "test_ep_combine_ordering.mojo.test",
    size = "large",
    srcs = ["test_ep_combine_ordering.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = ["gpu"],
    target_compatible_with = ["//:mi355_gpu"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)
