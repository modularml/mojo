# SM100 FP8 indexer prefill scorer at GLM-5.2 shapes. Excluded from the generic
# `gpu/**` glob above because a benchmark it builds as a `mojo_binary` cannot be
# TIMED on remote B200 -- only a test target can -- and a source may belong to
# exactly one rule. `manual`, so `//...` never runs the benchmark itself; the
# `build_test` below restores the compile coverage the glob would have given.
# Shape stays a runtime arg so one binary covers the whole grid; `num_heads` is
# a `-D`, so a head count other than the GLM 32 needs its own target.
mojo_test(
    name = "gpu/nn/bench_fp8_index_prefill.mojo.run",
    size = "enormous",
    srcs = ["gpu/nn/bench_fp8_index_prefill.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    enable_assertions = False,
    exec_properties = {
        "test.resources:gpu-memory": "8",
    },
    tags = [
        "gpu",
        "manual",
    ],
    target_compatible_with = ["//:b200_gpu"],  # tcgen05 / TMA / SS-UMMA
    deps = [
        "//max:internal_utils",
        "//max:layout",
        "//max:max_mojo",
        "//max:nn",
        "@mojo//:std",
    ],
)

build_test(
    name = "gpu/nn/bench_fp8_index_prefill.mojo.test",
    tags = ["gpu"],
    targets = ["gpu/nn/bench_fp8_index_prefill.mojo.run"],
)

# Deps/data/env shared by the softmax / m3 benchmark targets below.
_FA4_WS_DEPS = [
    "//max:comm",
    "//max:internal_utils",
    "//max:layout",
    "//max:nn",
    "//max:shmem",
    "//max:structured_kernels",
    "@mojo//:std",
]

# Row-wise softmax at MiniMax-M3's logits shapes: fp32 rows of 200,064 (full
# vocab, post-all-gather) against 50,016 (one TP4 vocab shard), at the decode
# row counts. Sizes the `algorithm.rowwise` split-K tier the sampling tail hits.
[
    mojo_test(
        name = "gpu/nn/bench_softmax.mojo.run_m3_logits_%dx%d" % (rows, cols),
        size = "enormous",
        srcs = ["gpu/nn/bench_softmax.mojo"],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS + [
            "-D",
            "dtype=DType.float32",
            "-D",
            "shape=%dx%d" % (rows, cols),
        ],
        enable_assertions = False,
        exec_properties = {
            "test.resources:gpu-memory": "16",
        },
        tags = [
            "gpu",
            "manual",
        ],
        deps = _FA4_WS_DEPS,
    )
    for rows in [
        16,
        64,
    ]
    for cols in [
        50016,
        200064,
    ]
]

# MiniMax-M3 dense-attention decode cell on MI355: 64 q heads and 4 kv heads
# over TP4 give num_heads=16 / group=16, depth 128, fp8_e4m3 KV, bf16 out.
# `num_partitions` stays a runtime arg so one binary sweeps the split-K ladder.
mojo_test(
    name = "gpu/nn/bench_mha.mojo.run_m3_dense_fp8_amd",
    size = "enormous",
    srcs = ["gpu/nn/bench_mha.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS + [
        "-D",
        "qkv_type=DType.float8_e4m3fn",
        "-D",
        "mask_type=DType.bfloat16",
        "-D",
        "depth=128",
        "-D",
        "num_heads=16",
        "-D",
        "group=16",
    ],
    enable_assertions = False,
    exec_properties = {
        "test.resources:gpu-memory": "64",
    },
    tags = [
        "gpu",
        "manual",
    ],
    target_compatible_with = ["//:amd_gpu"],
    deps = _FA4_WS_DEPS,
)

