load("//bazel:api.bzl", "modular_py_library", "requirement")

package(default_visibility = ["//max:consumers"])

modular_py_library(
    name = "request",
    srcs = glob(["**/*.py"]),
    deps = [
        # No HTTP client here on purpose: the serving layer fetches media URLs
        # (see MediaDataUriFetcher in open_responses.py).
        requirement("numpy"),
        requirement("pillow"),
        requirement("pydantic"),
    ],
)
