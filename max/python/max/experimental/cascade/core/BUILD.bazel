load("//bazel:api.bzl", "modular_py_library", "requirement")

package(default_visibility = ["//max:consumers"])

# Core cascade API: workers, results, proxies, runtime ABC.
modular_py_library(
    name = "core",
    srcs = glob(["*.py"]),
    deps = [
        "//max/python/max/support:taskgroups",
        requirement("numpy"),
        requirement("pydantic"),
    ],
)
