# Test for pipeline unit tests.

load("//bazel:api.bzl", "modular_py_test", "requirement")
load("//max/tests/integration/xarch_warm:eager_py_test.bzl", "modular_eager_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_model_config_subfolder",
    size = "small",
    srcs = ["test_model_config_subfolder.py"],
    tags = ["manual"],
    deps = [
        "//max/python/max/graph",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/weights",
        "//max/tests/integration/test_common:fake_weights",
        "//max/tests/integration/test_common:mocks",
        requirement("huggingface-hub"),
        requirement("pydantic"),
    ],
)

# Builds real Module weights, so unwarmed the first eager dispatch
# cold-compiles a GC model and blows the 60s budget.
modular_eager_py_test(
    name = "test_modulev3_lora_manager",
    size = "small",
    srcs = ["test_modulev3_lora_manager.py"],
    cpu_only = True,
    env = {
        # Don't background-compile every eager graph (SDLC-4307 CI cpu/mem).
        "MAX_EAGER_EXECUTOR": "fallback-internal",
    },
    ignore_extra_deps = [
        # lazy import
        "//max/python/max/_interpreter_ops",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],  # FIXME: MOCO-2411
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/pipelines/lora",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_model_config_encoding_resolution",
    size = "medium",
    srcs = ["test_model_config_encoding_resolution.py"],
    # These are offline unit tests: a stray hub lookup for a gated repo turns
    # into a 401 instead of a cache miss. Linux CI passes HF_HUB_OFFLINE=1 for
    # the whole invocation (ci/default/test.sh); the macOS lane does not, so
    # pin it per target.
    env = {"HF_HUB_OFFLINE": "1"},
    tags = ["skip-external-ci"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/graph",
        "//max/python/max/pipelines/diffusion",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/weights",
        "//max/tests/integration/test_common:fake_weights",
    ],
)

modular_py_test(
    name = "test_denoising_cache_defaults",
    size = "medium",
    srcs = ["test_denoising_cache_defaults.py"],
    # Offline unit tests; Linux CI passes HF_HUB_OFFLINE=1 for the whole
    # invocation (ci/default/test.sh), the macOS lane does not.
    env = {"HF_HUB_OFFLINE": "1"},
    # The root package registers the lazy architecture table; flux2/wan are
    # materialized at runtime by the construction-time architecture lookup.
    ignore_extra_deps = [
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/flux2",
        "//max/python/max/pipelines/architectures/wan",
    ],
    tags = ["skip-external-ci"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/flux2",
        "//max/python/max/pipelines/architectures/wan",
        "//max/python/max/pipelines/diffusion",
        "//max/python/max/pipelines/lib",
        "//max/tests/integration/test_common:fake_weights",
        requirement("pydantic"),
    ],
)

