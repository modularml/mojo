# The prompt tokenizer is faked, so unlike test_pixel_tokenizer this needs
# neither a checkpoint nor network access, and runs on CI.
modular_py_test(
    name = "test_audio_tokenizer",
    size = "small",
    srcs = [
        "test_audio_tokenizer.py",
    ],
    env = {
        "MODULAR_PATH": ".",
    },
    # Import-bound: pulling the whole pipelines stack dominates the wall time
    # and outruns the 300s "small" budget on the shared BuildBuddy macOS
    # workers, timing out during pytest collection. Nothing here is actually
    # macOS-incompatible, so skip the CI job rather than the platform -- it
    # still runs locally on a Mac.
    tags = ["skip-ci-macos"],
    deps = [
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/request",
        requirement("numpy"),
        requirement("pytest-asyncio"),
    ],
)

