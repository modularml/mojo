load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_incremental_detokenizer",
    size = "medium",
    srcs = [
        "test_incremental_detokenizer.py",
    ],
    env = {
        "MODULAR_PATH": ".",
        "MODULAR_TELEMETRY_ENABLED": "true",
    },
    env_inherit = ["HF_TOKEN"],
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//max/python/max/serve/pipelines:incremental_detokenizer",
        requirement("numpy"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "tests",
    size = "large",
    srcs = [
        "conftest.py",
        "test_tokenizer.py",
        "test_tool_calling.py",
    ],
    data = [
        "//max/tests/integration/Inputs:inputs",
        "//max/tests/integration/Inputs:pytest_inputs",
        "//max/tests/tests/graph/testdata",
    ],
    env = {
        "GRAPH_TESTDATA": "max/tests/tests/graph/testdata",
        "MODULAR_PATH": ".",
        "MODULAR_TELEMETRY_ENABLED": "true",
    },
    env_inherit = ["HF_TOKEN"],
    exec_properties = {
        "test.resources:gpu-memory": "20",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    ignore_extra_deps = [requirement("jinja2")],
    tags = [
        "gpu",
        "manual",
        "no-sandbox",
        "requires-network",
        "run-in-hf-workflow",  # TODO(AITLIB-293): Remove this once we have a way to run these tests on CI.
    ],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/engine",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/tests/integration/test_common:mocks",
        requirement("jinja2"),
        requirement("numpy"),
        requirement("pytest-asyncio"),
        requirement("requests"),
        requirement("transformers"),
    ],
)

