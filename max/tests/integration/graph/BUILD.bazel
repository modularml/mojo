        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],  # FIXME: MOCO-2411
        "//conditions:default": [],
    }),
    ignore_extra_deps = [
        # Optional dep of max.graph, used to test loading weights
        requirement("gguf"),
        # Loaded automatically by pytest; not imported by any test source.
        requirement("pytest-asyncio"),
    ],
    # ``AsyncValue.__await__`` (monkeypatched by max.engine.mlrt) declares
    # ``AsyncValue[T]`` in its signature; mypy resolves that to
    # ``max._core.mlrt.AsyncValue`` but the dep graph already covers it
