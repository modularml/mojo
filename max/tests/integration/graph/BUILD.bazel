        "//max/tests/integration/Inputs:pytest_inputs",
        "//max/tests/integration/Inputs/kernel_override_ops",
        "//max/tests/integration/Inputs/kernel_verification_ops",
        "//max/tests/integration/Inputs/test_user_op",
        "//max/tests/integration/graph/testdata/compile_config_ops",
        "//max/tests/integration/graph/testdata/counter_ops",
        "//max/tests/tests/graph/testdata",
