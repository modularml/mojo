modular_py_binary(
    name = "verify_pipelines",
    testonly = True,
    srcs = ["verify_pipelines.py"],
    data = [
        "//max/tests/integration/architectures/llama3/testdata",
        "@nvshmem_prebuilt//:host",
    ],
    env = {
        # PIPELINES_TESTDATA is required by the Llama3 scripts.
        "PIPELINES_TESTDATA": (
            "max/tests/integration/architectures/llama3/testdata"
        ),
        # required by models that use Expert Parallelism.
        "MODULAR_SHMEM_LIB_DIR": "../+http_archive+nvshmem_prebuilt",
    },
    ignore_extra_deps = ALL_ARCHITECTURES + [
        # accelerate isn't imported here directly, but transformers v5
        # requires it at from_pretrained time in the child process this
        # binary spawns (see deps comment below).
        requirement("accelerate"),
    ],
    # Expose this package as an import root so out-of-package entrypoints
    # (e.g. //max_private/minimax_m3:verify_minimax_m3) can `from
    # verify_pipelines import main`.
    imports = ["."],
    # Target-level visibility (the package default cannot list //max_private).
    # Mirrors the package default plus //max_private so private archs can host
    # their own logit-verification entrypoints that reuse this driver.
    visibility = [
        "//:__pkg__",
        "//SDK/integration-test:__subpackages__",
        "//max/tests:__subpackages__",
        "//max_private:__subpackages__",
        "//oss/modular/max/tests:__subpackages__",
    ],
    deps = [
        ":verify",
        "//max/python/max/pipelines/lib",
        "//max/tests/integration/accuracy/logit_verification:logit_verification_config",
        "//max/tests/integration/tools:generate_llm_logits",
        "//max/tests/integration/tools:tag_filters",
        requirement("click"),
        "//max/tests/integration/test_common:evaluate",
        "//max/tests/integration/test_common:numpy_encoder",
        "//max/tests/integration/test_common:process_isolation",
        "//max/tests/integration/test_common:storage",
        "@rules_python//python/runfiles",
        # transformers v5 requires this for device_map/torch.device loading.
        # verify_pipelines spawns generate_llm_logits as a child process,
        # which inherits this binary's runfiles tree, so accelerate must
        # be wired in here directly.
        requirement("accelerate"),
        requirement("numpy"),
        requirement("pillow"),
    ] + ALL_ARCHITECTURES,
)

modular_py_test(
    #a generic test that can be used with parameters
    name = "test_verify_pipelines",
    size = "enormous",
    srcs = ["test_verify_pipelines.py"],
    data = [
        "//max/tests/integration/architectures/llama3/testdata",
        "@nvshmem_prebuilt//:host",
    ],
    env = {
        # PIPELINES_TESTDATA is required by the Llama3 scripts.
        "PIPELINES_TESTDATA": (
            "max/tests/integration/architectures/llama3/testdata"
        ),
        # required by models that use Expert Parallelism.
        "MODULAR_SHMEM_LIB_DIR": "../+http_archive+nvshmem_prebuilt",
    },
    exec_properties = {
        "test.resources:gpu-memory": "80",
    },
    gpu_constraints = ["//:has_gpu"],
    main = "test_verify_pipelines.py",
    tags = [
        "gpu",
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":verify_pipelines",
        requirement("click"),
    ],
)

modular_py_test(
    name = "allenai/OLMo-1B-hf-float32",
    size = "large",
    srcs = ["test_verify_pipelines.py"],
    args = [
        "--pipeline=allenai/OLMo-1B-hf-float32",
        "--devices=cpu",
        "--override-pipeline-golden-location",
        "allenai/OLMo-1B-hf-float32:$(rootpath @torch_olmo-1b-hf_golden.tar.gz//file:downloaded)",
    ],
    data = [
        "//max/tests/integration/architectures/llama3/testdata",
        "@nvshmem_prebuilt//:host",
        "@torch_olmo-1b-hf_golden.tar.gz//file:downloaded",
    ],
    env = {
        "HF_HUB_OFFLINE": "1",  #needed to run locally
        # PIPELINES_TESTDATA is required by the Llama3 scripts.
        "PIPELINES_TESTDATA": (
            "max/tests/integration/architectures/llama3/testdata"
        ),
        # required by models that use Expert Parallelism.
        "MODULAR_SHMEM_LIB_DIR": "../+http_archive+nvshmem_prebuilt",
    },
    main = "test_verify_pipelines.py",
    # SDLC-3497: MAX OLMo is not yet transformers v5 compatible; the v4
    # wheel hack that masked this on main was removed in this branch.
    # "manual" excludes it from automated runs; re-enable once OLMo MAX
    # is fixed for transformers >=5 (tracked separately).
    tags = [
        "manual",
        "skip-external-ci",
    ],  # skip-external-ci: QUA-61
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//:asan": ["@platforms//:incompatible"],  # FIXME MODELS-1202: Disabled due to asan timeout
        "//conditions:default": [],
    }),
    deps = [
        ":verify_pipelines",
        requirement("click"),
    ],
)

