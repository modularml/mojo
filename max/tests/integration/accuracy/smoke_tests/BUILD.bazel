load("//bazel:api.bzl", "modular_py_binary", "modular_py_library", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_library(
    name = "inference_server_harness",
    testonly = True,
    srcs = ["inference_server_harness.py"],
    imports = ["."],
    deps = [
        requirement("requests"),
    ],
)

modular_py_library(
    name = "eval_runner",
    testonly = True,
    srcs = ["eval_runner.py"],
    data = glob([
        "tasks/**",
    ]),
    imports = [".."],
    tags = ["no-pydeps"],  # TODO: Fix and re-enable
    deps = [
        requirement("requests"),
        requirement("lm-eval"),
    ],
)

modular_py_binary(
    name = "smoke_test",
    testonly = True,
    srcs = ["smoke_test.py"],
    imports = [".."],
    tags = ["no-pydeps"],  # TODO: Fix and re-enable
    # Mirror the package default plus //max_private so private archs (e.g.
    # //max_private/minimax_m3:smoke_test_m3) can host their own smoke-test
    # entrypoints that reuse this driver. Mirrors verify_pipelines.
    # //max/internal covers the kernel-model-map graph tooling.
    visibility = [
        "//:__pkg__",
        "//SDK/integration-test:__subpackages__",
        "//max/internal:__subpackages__",
        "//max/tests:__subpackages__",
        "//max_private:__subpackages__",
        "//oss/modular/max/tests:__subpackages__",
    ],
    deps = [
        ":eval_runner",
        ":inference_server_harness",
        requirement("click"),
        requirement("pydantic"),
        requirement("pyyaml"),
        "//max/python/max/_entrypoints:pipelines",
    ],
)

modular_py_binary(
    name = "smoke_test_github_matrix",
    srcs = ["smoke_test_github_matrix.py"],
    imports = [".."],
    visibility = [
        "//:__pkg__",
        "//SDK/integration-test:__subpackages__",
        "//ci/serve_smoke_tests_workflow:__pkg__",
        "//max/internal:__subpackages__",
        "//max/tests:__subpackages__",
        "//oss/modular/max/tests:__subpackages__",
    ],
    deps = [
        requirement("click"),
    ],
)

modular_py_binary(
    name = "prefetch_hf_repos",
    testonly = True,
    srcs = ["prefetch_hf_repos.py"],
    imports = [".."],
    tags = ["no-pydeps"],
    deps = [
        ":smoke_test",
        requirement("click"),
        requirement("huggingface-hub"),
    ],
)

modular_py_binary(
    name = "bisect_smoke_test",
    testonly = True,
    srcs = ["bisect_smoke_test.py"],
    imports = [".."],
)

modular_py_test(
    name = "test_smoke_test",
    size = "small",
    srcs = [
        "conftest.py",
        "test_smoke_test.py",
    ],
    imports = [".."],
    tags = ["no-pydeps"],  # Depends on :smoke_test binary for imports
    # TODO(MODELS-994): Investigate and enable on macOS
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":smoke_test",
    ],
)

modular_py_test(
    name = "test_prefetch_hf_repos",
    size = "small",
    srcs = [
        "conftest.py",
        "test_prefetch_hf_repos.py",
    ],
    imports = [".."],
    tags = ["no-pydeps"],  # Depends on :prefetch_hf_repos binary for imports
    # TODO(MODELS-994): Investigate and enable on macOS
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":prefetch_hf_repos",
    ],
)

modular_py_test(
    name = "test_bisect_smoke_test",
    size = "small",
    srcs = [
        "conftest.py",
        "test_bisect_smoke_test.py",
    ],
    imports = [".."],
    tags = ["no-pydeps"],  # Depends on :smoke_test binary for imports
    # TODO(MODELS-994): Investigate and enable on macOS
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":bisect_smoke_test",
        ":eval_runner",
    ],
)

modular_py_test(
    name = "test_smoke_test_github_matrix",
    size = "small",
    srcs = [
        "conftest.py",
        "test_smoke_test_github_matrix.py",
    ],
    imports = [".."],
    tags = ["no-pydeps"],  # Depends on :smoke_test binary for imports
    # TODO(MODELS-994): Investigate and enable on macOS
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":smoke_test",
        ":smoke_test_github_matrix",
        requirement("click"),
    ],
)
