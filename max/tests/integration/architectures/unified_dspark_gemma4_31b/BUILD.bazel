load("//bazel:api.bzl", "modular_py_library", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_library(
    name = "speculators_reference",
    testonly = True,
    srcs = ["speculators_reference.py"],
    imports = ["."],
    deps = [
        requirement("torch"),
    ],
)

modular_py_test(
    name = "test_arch_registration",
    size = "medium",
    srcs = ["test_arch_registration.py"],
    deps = [
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/speculators_common",
        "//max/python/max/pipelines/architectures/unified_dspark_gemma4_31b",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_model_config",
    size = "medium",
    srcs = ["test_model_config.py"],
    data = ["//max/tests/integration/architectures/unified_dspark_gemma4_31b/testdata"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/speculators_common",
        "//max/python/max/pipelines/architectures/unified_dspark_gemma4_31b",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/weights",
        requirement("numpy"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_weight_audit",
    size = "large",
    srcs = ["test_weight_audit.py"],
    data = ["//max/tests/integration/architectures/unified_dspark_gemma4_31b/testdata"],
    env = {
        # Reuse the host HF cache: only the safetensors header and the tiny
        # d2t table are read, but the cached snapshot is 8.4 GB.
        "HF_ESCAPES_SANDBOX": "1",
    },
    env_inherit = [
        "HF_TOKEN",
        "HF_HOME",
    ],
    # Reads the 8.4 GB checkpoint snapshot on every run — too costly
    # per-submission; the load-time audits in the pipeline model cover the
    # wiring. Run explicitly, like the unified-graph compile tests.
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/dspark_draft",
        "//max/python/max/pipelines/architectures/speculators_common",
        requirement("huggingface-hub"),
        requirement("numpy"),
        requirement("safetensors"),
    ],
)

modular_py_test(
    name = "test_unified_graph_compile",
    size = "enormous",
    srcs = ["test_unified_graph_compile.py"],
    data = ["//max/tests/integration/architectures/unified_dspark_gemma4_31b/testdata"],
    exec_properties = {
        # Zero-filled weights at real 31B dims: ~63 GiB target + ~9 GiB
        # draft on the device, plus compile working set.
        "test.resources:gpu-memory": "100",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    # Compiles the 60-layer unified graph at real dims — tens of minutes on
    # one B200. Run explicitly, like the 12B unified-graph compile test.
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/speculators_common",
        "//max/python/max/pipelines/architectures/unified_dspark_gemma4_31b",
        "//max/python/max/pipelines/lib",
        requirement("torch"),
    ],
)

modular_py_test(
    name = "test_dspark_speculators_module",
    size = "enormous",
    srcs = ["test_dspark_speculators_module.py"],
