    env_inherit = ["HF_TOKEN"],
    exec_properties = {
        "test.resources:gpu-memory": "24",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    # Downloads the full speculators checkpoint and runs the GPU logit
    # verify — too costly per-submission; the smoke matrix covers serving.
    # Run explicitly, like the unified-graph compile tests.
    tags = [
        "gpu",
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":speculators_reference",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/dspark_draft",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/test_common:context_utils",
        requirement("huggingface-hub"),
        requirement("numpy"),
        requirement("safetensors"),
        requirement("torch"),
    ],
)

modular_py_test(
    name = "test_unified_step_parity",
    size = "enormous",
    srcs = ["test_unified_step_parity.py"],
    env = {
        # The torch draft reference holds a few GiB; MAX's DeviceContext
        # takes the rest for the ~71 GiB unified weights + compile.
        "MODULAR_TORCH_MEMORY_PERCENT": "0.1",
        # Reuse the host HF cache: the 31B target is far too large to
        # re-download into TEST_TMPDIR on every run.
        "HF_ESCAPES_SANDBOX": "1",
    },
    env_inherit = [
        "HF_TOKEN",
        "HF_HOME",
    ],
    exec_properties = {
        "test.resources:gpu-memory": "140",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    # Loads the real google/gemma-4-31B-it weights and compiles the unified
    # 60-layer graph at real dims — tens of minutes on one B200. Run
    # explicitly, like the unified-graph compile test.
    tags = [
        "gpu",
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":speculators_reference",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/speculators_common",
        "//max/python/max/pipelines/architectures/unified_dspark_gemma4_31b",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/tests/integration/test_common:context_utils",
        requirement("huggingface-hub"),
        requirement("numpy"),
        requirement("safetensors"),
        requirement("torch"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_target_tap_parity",
    size = "enormous",
    srcs = ["test_target_tap_parity.py"],
    env = {
        # The runner statically splits the gpu-memory request: torch gets
        # this fraction (the bf16 31B checkpoint needs ~62 GiB; the fp32
        # oracle runs on host RAM) and MAX's DeviceContext the remainder
        # (~62 GiB weights + KV pages).
        "MODULAR_TORCH_MEMORY_PERCENT": "0.45",
        # Reuse the host HF cache: the 31B checkpoint is far too large to
        # re-download into TEST_TMPDIR on every run.
        "HF_ESCAPES_SANDBOX": "1",
    },
    env_inherit = [
        "HF_TOKEN",
        "HF_HOME",
    ],
    exec_properties = {
        "test.resources:gpu-memory": "160",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    # transformers loads the checkpoint with device_map=..., which needs
    # accelerate at runtime without importing it directly.
    ignore_extra_deps = [requirement("accelerate")],
    # Loads the real google/gemma-4-31B-it weights three times and compiles
    # the 60-layer target graph at real dims — tens of minutes on one B200.
    # Run explicitly, like the unified-graph compile tests.
    tags = [
        "gpu",
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/test_common:context_utils",
        requirement("accelerate"),
        requirement("huggingface-hub"),
        requirement("numpy"),
        requirement("torch"),
        requirement("transformers"),
    ],
)
