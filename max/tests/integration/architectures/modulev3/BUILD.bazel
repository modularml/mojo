# ModuleV3 load_model() integration tests.

load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_arch_parity",
    srcs = ["test_arch_parity.py"],
    deps = [
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_modulev3",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "tests_gpu",
    size = "enormous",
    srcs = glob(
        ["test_*.py"],
        exclude = ["test_arch_parity.py"],
    ),
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = [
        "gpu",
        "manual",  # TODO (MODELS-1354): This is timing out, re-enable after investigation
    ],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/experimental",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_modulev3",
        "//max/python/max/pipelines/architectures/llama3_modulev3",
        "//max/python/max/pipelines/architectures/olmo_modulev3",
        "//max/python/max/pipelines/architectures/phi3_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/tests/integration/test_common:load_model_helpers",
        requirement("numpy"),
        requirement("torch"),
        requirement("transformers"),
    ],
)
