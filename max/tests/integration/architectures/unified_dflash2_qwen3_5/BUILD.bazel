# Fused DFlash2 Qwen3.5 integration tests.

load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_model_config",
    srcs = ["test_model_config.py"],
    data = ["testdata/zlab_dflash2_config.json"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/llama3",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/architectures/unified_dflash2_qwen3_5",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_arch_registration",
    srcs = ["test_arch_registration.py"],
    deps = [
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/architectures/unified_dflash2_qwen3_5",
    ],
)

modular_py_test(
    name = "test_graph_signature",
    srcs = ["test_graph_signature.py"],
    # Constructing either fused module reaches `Allreduce.__init__`, which
    # instantiates `Accelerator(id=0)` unconditionally; with no CUDA device
    # that aborts inside the driver rather than raising.
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    tags = ["gpu"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/llama3",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/architectures/unified_dflash2_qwen3_5",
        "//max/python/max/pipelines/architectures/unified_mtp_qwen3_5",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_state_rollback_block",
    srcs = ["test_state_rollback_block.py"],
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/architectures/unified_mtp_qwen3_5",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_tap_capture",
    size = "large",
    srcs = ["test_tap_capture.py"],
    # The 280 MB signal buffer is a single allocation, so the default per-test
    # GPU budget cannot serve it whatever the model size.
    exec_properties = {
        "test.resources:gpu-memory": "8",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    # Six tiny Qwen3.5 compiles; sharding runs them on separate workers.
    shard_count = 3,
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/test_common:context_utils",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_prefill_block",
    size = "large",
    srcs = ["test_prefill_block.py"],
    # The 280 MB signal buffer is a single allocation, so the default per-test
    # GPU budget cannot serve it whatever the model size.
    exec_properties = {
        "test.resources:gpu-memory": "8",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/llama3",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/architectures/unified_dflash2_qwen3_5",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)
