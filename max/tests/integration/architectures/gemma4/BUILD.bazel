load(
    "//bazel:api.bzl",
    "modular_py_binary",
    "modular_py_library",
    "modular_py_test",
    "requirement",
)
load("//max/tests/integration/test_common:mef_precompile.bzl", "CPU_TORCH", "precompiled_mefs")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

filegroup(
    name = "gemma4_e4b_config",
    srcs = ["configs/gemma4_e4b/config.json"],
)

modular_py_test(
    name = "test_config_init",
    srcs = ["test_config_init.py"],
    data = [":gemma4_e4b_config"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/lib",
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_fused_projection_weights",
    srcs = ["test_fused_projection_weights.py"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_batch_vision_inputs_cpu",
    srcs = ["test_batch_vision_inputs.py"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "tests",
    size = "large",
    srcs = glob(
        ["**/test_*.py"],
        exclude = [
            "test_attention.py",
            "test_batch_vision_inputs.py",
            "test_config_init.py",
            "test_fused_projection_weights.py",
            "test_image_processor.py",
            "test_reasoning.py",
            "test_tokenizer.py",
            "test_tool_parser.py",
            "test_video_processor.py",
            "test_vision_rotary_embedding.py",
        ],
    ) + [
        "conftest.py",
    ],
    data = [
        "//max/tests/integration/architectures/gemma4/testdata",
    ],
    env = {
        "PIPELINES_TESTDATA": "max/tests/integration/architectures/gemma4/testdata",
        "MODULAR_TORCH_MEMORY_PERCENT": "0.5",
    },
    exec_properties = {
        # Increased from 4 to 16 due to MODELS-958
        "test.resources:gpu-memory": "16",
    },
    gpu_constraints = ["//:has_gpu"],
    tags = ["gpu"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        requirement("numpy"),
        requirement("torch"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_image_processor",
    srcs = [
        "hf_gemma4_reference.py",
        "test_image_processor.py",
    ],
    env_inherit = ["HF_TOKEN"],
    imports = ["."],
    tags = [
        "manual",
        "requires-network",
    ],
    deps = [
        "//max/python/max/pipelines/architectures/gemma4",
        requirement("numpy"),
        requirement("pillow"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_tokenizer",
    srcs = ["test_tokenizer.py"],
    deps = [
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/support",
        requirement("numpy"),
        requirement("pillow"),
        requirement("pytest-asyncio"),
        requirement("pytest-mock"),
    ],
)

modular_py_test(
    name = "test_reasoning",
    srcs = ["test_reasoning.py"],
    deps = [
        "//max/python/max/pipelines/architectures/gemma4",
        requirement("numpy"),
        requirement("pytest-asyncio"),
    ],
)

modular_py_test(
    name = "test_tool_parser",
    srcs = ["test_tool_parser.py"],
    deps = [
        "//max/python/max/_xgrammar",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/modeling",
    ],
)

modular_py_test(
    name = "test_video_processor",
    srcs = ["test_video_processor.py"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    deps = [
        "//max/python/max/pipelines/architectures/gemma4",
        requirement("av"),
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_vision_rotary_embedding",
    srcs = ["test_vision_rotary_embedding.py"],
    # TODO(MODELS-1371): `test_compute_vision_freqs_cis_matches_hf_reference`
    # hangs for >10 minutes on remote macOS workers.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/gemma4",
        requirement("torch"),
    ],
)

modular_py_library(
    name = "attention_helpers",
    testonly = True,
    srcs = [
        "_attention_helpers.py",
    ],
    data = [
        "//max/tests/integration/architectures/gemma4/testdata",
    ],
    # Needs to be lazy, see definition of CPU_TORCH
    ignore_unresolved_imports = [
        "torch",
    ],
    imports = ["."],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/kv_cache",
        requirement("transformers"),
    ],
)

modular_py_binary(
    name = "precompile_attention_mefs",
    testonly = True,
    srcs = ["precompile_attention_mefs.py"],
    data = [
        "//max/tests/integration/architectures/gemma4/testdata",
    ],
    env = {
        "PIPELINES_TESTDATA": "max/tests/integration/architectures/gemma4/testdata",
    },
    # FIXME: pydeps_test sees CPU_TORCH as two torch deps, so `ignore_extra_deps` needs
    # both. But we can't add both, because they're mutually incompatible.
    tags = ["no-pydeps"],
    deps = [
        ":attention_helpers",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/tests/integration/test_common:mef_precompile",
    ] + CPU_TORCH,
)

precompiled_mefs(
    name = "attention_mefs",
    producer = ":precompile_attention_mefs",
    specs = [
        "compiled_local_bf16",
        "compiled_global_bf16",
    ] + select({
        "//:b200_gpu": [
            "compiled_local_native_fp8",
            "compiled_global_native_fp8",
        ],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

modular_py_test(
    name = "test_attention",
    size = "large",
    srcs = [
        "conftest.py",
        "test_attention.py",
    ],
    data = [
        ":attention_mefs",
        "//max/tests/integration/architectures/gemma4/testdata",
    ],
    env = {
        "PIPELINES_TESTDATA": "max/tests/integration/architectures/gemma4/testdata",
        "MEF_RLOCATIONS": "$(rlocationpaths :attention_mefs)",
        "MODULAR_TORCH_MEMORY_PERCENT": "0.5",
    },
    exec_properties = {
        # Increased from 4 to 16 due to MODELS-958
        "test.resources:gpu-memory": "16",
    },
    gpu_constraints = ["//:has_gpu"],
    tags = ["gpu"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":attention_helpers",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/test_common:context_utils",
        "//max/tests/integration/test_common:graph_utils",
        "//max/tests/integration/test_common:mef_precompile",
        requirement("numpy"),
        requirement("torch"),
        requirement("transformers"),
    ],
)
