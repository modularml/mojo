modular_py_test(
    name = "test_all_pipelines",
    size = "medium",
    srcs = ["test_all_pipelines.py"],
    # Config construction must not reach the hub: these cases build a config
    # for a placeholder repo. Linux CI passes HF_HUB_OFFLINE=1 for the whole
    # invocation (ci/default/test.sh); the macOS lane does not, so pin it here.
    env = {"HF_HUB_OFFLINE": "1"},
    tags = ["skip-external-ci"],
    # TODO(SERVSYS-1284): importing max.pipelines.lib alone blows the 300s
    # budget on the shared BuildBuddy macOS workers (times out in pytest
    # collection);
    # However we can't disable this on mac-os because mac-os is our primary
    # developer platform for this code.
    # TODO - find a different way to make the BB macOS runner pretend to be green.
    deps = [
        # all_pipelines brings every architecture (llama3 resolves SmolLM at
        # runtime); pipelines provides the CommonTextGenPipeline class.
        "//max/python/max/experimental/cascade/pipelines",
        "//max/python/max/experimental/cascade/pipelines:all_pipelines",
        "//max/python/max/experimental/cascade/workers",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        requirement("pytest-asyncio"),
    ],
)

modular_py_test(
    name = "test_arch_import_layering",
    size = "medium",
    srcs = ["test_arch_import_layering.py"],
    # The architecture module is imported dynamically (importlib, inside the
    # test) so the static scanner can't see the dependency.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures/llama3",
    ],
    # Importing the Llama architecture pulls max.pipelines.lib, which alone can
    # blow the 300s budget on the shared BuildBuddy macOS workers (times out in
    # pytest collection);
    # However we can't disable this on mac-os because mac-os is our primary
    # developer platform for this code.
    # TODO - find a different way to make the BB macOS runner pretend to be green.
    deps = [
        "//max/python/max/pipelines/architectures/llama3",
    ],
)

