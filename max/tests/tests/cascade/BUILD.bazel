modular_py_test(
    name = "test_real_tool_parsers",
    size = "medium",
    srcs = ["test_real_tool_parsers.py"],
    # Importing the Kimi/MiniMax tool parsers pulls max.pipelines.lib, which
    # alone can blow the 300s budget on shared BuildBuddy macOS workers (times
    # out in pytest collection)
    # However we can't disable this on mac-os because mac-os is our primary developer platform for this code.
    # TODO - find a different way to fix the BB macOS runner
    deps = [
        "//max/python/max/experimental/cascade/interfaces",
        "//max/python/max/experimental/cascade/pipelines",
        "//max/python/max/pipelines/architectures/kimik2_5",
        "//max/python/max/pipelines/architectures/laguna",
        "//max/python/max/pipelines/architectures/minimax_m2",
    ],
)

modular_py_test(
    name = "test_cascade_tool_calling",
    size = "small",
    srcs = ["test_cascade_tool_calling.py"],
    # Import-bound: the cascade + fastapi/httpx import graph alone outruns the
    # 300s "small" budget on the shared BuildBuddy macOS workers, timing out
    # during pytest collection before a single test body runs. Skip the CI job
    # rather than the platform, so it keeps running locally on a Mac.
    tags = ["skip-ci-macos"],
    deps = [
        "//max/python/max/experimental/cascade",
        "//max/python/max/experimental/cascade/pipelines",
        "//max/python/max/experimental/cascade/serve",
        requirement("fastapi"),
        requirement("httpx"),
        requirement("pytest-asyncio"),
    ],
)

