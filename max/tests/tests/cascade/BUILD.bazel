load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_native_backends",
    size = "small",
    srcs = ["test_native_backends.py"],
    # aiohttp transitively provides multidict + frozenlist, which the test
    # probes by name; it does not import aiohttp itself, hence ignore_extra_deps.
    ignore_extra_deps = [
        requirement("aiohttp"),
    ],
    deps = [
        requirement("aiohttp"),
    ],
)

