# Minimal range-annotation and profiler-control API: per-copy
# hot-path gates plus thin forwarders into an optional RangeSink that the
# host-side profiler integration (:ProfilerHostGlue below) provides by
# overriding the weak Detail::acquireRangeSink() at link time.
# Nothing profiler-specific lives here — no dlopen, no plugin ABI, no
# backend vocabulary — so the library is OSS-clean by construction and every
# binary links it unconditionally, with no build config and no packaging
# cost. Binaries without the glue get safe no-ops.
modular_cc_library(
    name = "ProfilingRanges",
    srcs = [
        "lib/Profiling/ExternalProfilerAnnotation.cpp",
        "lib/Profiling/Ranges.cpp",
    ],
    hdrs = [
        "include/Support/Profiling/ExternalProfilerAnnotation.h",
        "include/Support/Profiling/Ranges.h",
    ],
    deps = [
        # Holds the process-global gates + cached sink, so every statically
        # linked copy of the shim observes the same state (see Ranges.h).
        ":Globals",
        ":Base",
        "@llvm-project//llvm:Support",
    ],
)

# Header-only view of the range API for the profiler plugin implementation
# (//max/internal/profiler), which compiles against Ranges.h but must NOT
# link :ProfilingRanges — the plugin defines the same M::Profiling symbols, and
# pulling both archives into its link would leave symbol resolution to
# archive order.
modular_cc_library(
    name = "ProfilingRangesHeaders",
    hdrs = ["include/Support/Profiling/Ranges.h"],
    visibility = ["//max/internal/profiler:__pkg__"],
    deps = [":Base"],
)

# The C ABI between :ProfilerHostGlue and the runtime-loaded profiler plugin
# (//max/internal/profiler:MAXProfilerPlugin). Header-only so the plugin
# implementation compiles against it without linking any host-side code.
modular_cc_library(
    name = "ProfilerPluginABI",
    hdrs = ["include/Support/Profiling/PluginABI.h"],
    visibility = ["//max/internal/profiler:__pkg__"],
)

# Host-side glue for the minimal range API (:ProfilingRanges): provides the STRONG
# Detail::acquireRangeSink() override (the weak default no-ops), the dlopen
# loader for libMAXProfilerPlugin.so, and the RangeSink that forwards into
# the plugin's C call table. Linking this target into a binary is the only
# profiler wiring there is; alwayslink keeps the override from being dropped
# from the archive. OSS builds never compile it: the OSS api.bzl stubs the
# target by name, and KGEN CompilerRT reaches it via internal_deps, which
# the OSS build drops.
modular_cc_library(
    name = "ProfilerHostGlue",
    srcs = ["lib/ProfilerHostGlue.cpp"],
    local_defines = select({
        # Tracy owns CUPTI; the glue compiles its loader out so the two GPU
        # profilers can never meet in one process. Always assigned a value
        # (0/1) so ProfilerHostGlue.cpp can use `#if` (lint_ifdefs contract).
        "//:tracy_enabled": ["MODULAR_TRACY_BUILD=1"],
        "//conditions:default": ["MODULAR_TRACY_BUILD=0"],
    }),
    visibility = [
        "//MLRT:__pkg__",
        "//Mojo:__pkg__",
        "//mach/crates/max-sys-internal:__pkg__",
        "//max/internal:__pkg__",
        "//max/internal/profiler:__pkg__",
        "//max/python/max/_core/internal:__subpackages__",
        "//max/tests/internal/profiler:__pkg__",
    ],
    deps = [
        # Configuration backs the max-debug.profiling-enabled auto-start knob
        # the DeviceInit load trigger consults.
        ":Configuration",
        ":ProfilerPluginABI",
        ":ProfilingRanges",
        "@llvm-project//llvm:Support",
    ],
    alwayslink = True,
)

# Host-side glue for the external profiler annotation sink (:ProfilingRanges'
# ExternalProfilerAnnotation.h): provides the STRONG
# Detail::acquireExternalProfilerAnnotationSink() override (the weak default
# no-ops) and the dlopen loader for the external profiler annotation shim,
# libmax_profiler_shim.so. Same wiring model as :ProfilerHostGlue — linking
# this target is the only wiring, alwayslink keeps the override in the
# archive, KGEN CompilerRT reaches it via internal_deps, and OSS builds drop
# it and keep the inert weak default.
modular_cc_library(
    name = "ExternalProfilerAnnotationHostGlue",
    srcs = ["lib/ExternalProfilerAnnotationHostGlue.cpp"],
    visibility = [
        "//Mojo:__pkg__",
        "//max/internal/profiler:__pkg__",
    ],
    deps = [
        # StringExtras backs the MODULAR_ENABLE_PROFILING truthiness rule
        # (isTrueLike), shared with the Python profiler bindings.
        ":Base",
        ":ProfilingRanges",
        "@llvm-project//llvm:Support",
    ],
    alwayslink = True,
)

# NOTE: Passed as defines to propagate to dependents.
# TRACY_CUDA_ENABLE is propagated so consumers (e.g. CUDADeviceContext.cpp)
# see the same define and the no-op vs. real initTracyCuda() are consistent.
# TRACY_ROCM_ENABLE is propagated so consumers (e.g. HIPDeviceContext.cpp)
# see the same define and the no-op vs. real initTracyRocm() are consistent.
PROFILING_DEFINES = ASYNCRT_PROFILING_LOCAL_DEFINES + select({
    "//:tracy_cuda_enabled": ["TRACY_CUDA_ENABLE=1"],
    "//conditions:default": ["TRACY_CUDA_ENABLE=0"],
}) + select({
    "//:tracy_rocm_enabled": ["TRACY_ROCM_ENABLE=1"],
    "//conditions:default": ["TRACY_ROCM_ENABLE=0"],
})

PROFILING_DEPS = [
    ":Base",
    # Configuration backs the session.debug.profiling_* settings that
    # Range.cpp reads at enable()/disable() time.
    ":Configuration",
    ":Globals",
    ":MArchTargetMinimal",
    ":SymbolExport",
    "//Config",
    "@llvm-project//llvm:Support",
] + select({
    # Tracy without CUDA support
    "//:tracy_enabled": ["@tracy//:Tracy"],
    "//conditions:default": [],
}) + select({
    # Tracy CUDA support - only when both Tracy and NVIDIA GPU are enabled.
    # cuda_cupti_headers provides <cupti.h> for TracyCUDA.hpp.
    # cuda_runtime_headers provides cuda_runtime_api.h (transitively
    # included by cupti.h) without linking against libcudart.so.
    # libcudart_stub provides cudaDeviceSynchronize (called by
    # TracyCUDA.hpp inline functions) via on-demand dlopen of libcudart.so,
    # avoiding a hard NEEDED entry.
    "//:tracy_cuda_enabled": [
        "//bazel/third-party:cuda_cupti_headers",
        "//bazel/third-party:cuda_runtime_headers",
        "//bazel/third-party:libcudart_stub",
    ],
    "//conditions:default": [],
}) + select({
    # Tracy ROCm support - only when both Tracy and AMD GPU are enabled.
    # rocprofiler_headers is needed for compiling rocprofiler-sdk types
    # used in the Profiling sources.
    "//:tracy_rocm_enabled": [
        "//bazel/third-party:rocprofiler_headers",
    ],
    "//conditions:default": [],
})

# Modular's Tracy profiler integration (CPU zones + the TracyCuda/TracyRocm
# GPU backends). The FILES live under Support/internal/ so they follow the
# standardized internal-directory exclusion and are never part of any
# open-source export; this target keeps the long-standing name so the many
# compiler-stack consumers keep their dep label and the OSS build keeps
# stubbing it by name in oss/modular/bazel/api.bzl.
modular_cc_library(
    name = "Profiling",
    srcs = [
        "internal/Tracy/TracyCuda.cpp",
        "internal/Tracy/TracyRocm.cpp",
    ],
    hdrs = [
        "internal/Tracy/Tracy.h",
        "internal/Tracy/TracyCuda.h",
        "internal/Tracy/TracyRocm.h",
        "internal/Tracy/TracyZone.h",
    ],
    # TracyRocm.cpp uses a constructor to promote Tracy symbols to RTLD_GLOBAL
    # so that the rocprofiler-sdk plugin can resolve them via dlsym.
    copts = ["-Wno-global-constructors"],
    defines = PROFILING_DEFINES,
    deps = PROFILING_DEPS,
)

