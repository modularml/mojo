include "mlir/Pass/PassBase.td"

//===----------------------------------------------------------------------===//
// FunctionStats
//===----------------------------------------------------------------------===//

def FunctionStats : Pass<"function-stats", "ModuleOp"> {
  let summary = "Print function stats.";
  let description = [{
    The `function-stats` pass analyzes functions in the module and prints them.
    This is useful for debugging mainly.
  }];
}

//===----------------------------------------------------------------------===//
// Canonicalizer
//===----------------------------------------------------------------------===//

def Canonicalizer : Pass<"canonicalizer"> {
  let summary = "Canonicalize operations.";
  let description = [{
    The `canonicalizer` pass runs all registered canonicalization patterns in
    addition to KGEN-specific canonicalization patterns that run on the hybrid
    IR representation. This pass also disables the region simplifier, since KGEN
    IR only has single-block regions.
  }];

  // FIXME(#15949): Should not require all these dialects to be loaded.
  let dependentDialects = [
    "KGENDialect",
    "DebugInfo::DebugInfoDialect",
    "HLCF::HLCFDialect",
    "MDialect",
    "mlir::LLVM::LLVMDialect",
    "mlir::NVVM::NVVMDialect",
    "mlir::ROCDL::ROCDLDialect",
    "mlir::index::IndexDialect",
    "mlir::ub::UBDialect",
  ];
}

//===----------------------------------------------------------------------===//
// VerifyParameters
//===----------------------------------------------------------------------===//

def VerifyParameters : Pass<"verify-parameters", "ModuleOp"> {
  let summary = "Run the parameter verifier.";
  let description = [{
    The `verify-parameters` pass runs the KGEN parameter verifier. The pass
    ensures that all parameter uses are of the right type and reference
    parameters with declarations, it detects conflicting declarations, and it
    detects cycles in parameter definitions and uses.
  }];

  let options = [
    Option<"simplifyParameters", "simplify", "bool", "false",
           "If true, parameter simplification will run after verification.">,
  ];

  let dependentDialects = [
    "KGENDialect"
  ];
}

//===----------------------------------------------------------------------===//
// LiftAndFoldApply
//===----------------------------------------------------------------------===//

def LiftAndFoldApply : Pass<"lift-and-fold-apply", "ModuleOp"> {
  let summary = "Lift apply operators and fold them if possible.";
  let description = [{
    This pass walks parameter expressions within the bodies of functions and
    lifts and deduplicates visited 'apply' operators to `kgen.param.apply`
    operations within the function body. This enables the elaborator to
    multi-version generators from 'apply' operators whose callee has multiple
    candidates.

    This pass also attempts to interpret 'apply' operators on constant inputs
    on non-parametric callees.

    Note that the IR generated by this pass may not pass `verify-parameters`.
    This is because by modifying 'apply' operators within call operations, it
    can create concrete signatures that disagree with what the standard
    `ParameterEvaluator` determines as the concrete signature for a callee.
  }];

  let statistics = [
    Statistic<"numDedupedApplies", "num-deduped-applies",
              "the number of 'apply' operators deduplicated">,
  ];
}

//===----------------------------------------------------------------------===//
// LowerSemanticCF
//===----------------------------------------------------------------------===//

def LowerSemanticCF
  : Pass<"lower-semantic-cf", "ModuleOp"> {
  let summary = "Lower lexical terminators and prune unreachable code.";
  let description = [{
    The `lower-semantic-cf` pass will replace lexical Lit terminators with
    real terminators and prune any unreachable code (and warn about it).
  }];
}

//===----------------------------------------------------------------------===//
// CheckLifetimes
//===----------------------------------------------------------------------===//

def CheckLifetimes : Pass<"check-lifetimes"> {
  let summary = "Check and lower value lifetime invariants.";
  let description = [{
    The `check-lifetimes` pass inserts destructor calls after the last
    use of a value, diagnoses use-before-definition problems, and implements a
    borrow checker.
  }];
  let options = [
    Option<"extendTrivialDebugLifetimes", "extend-trivial-debug-lifetimes",
           "bool", "false",
           "At -O0, suppress debuginfo.kill markers for variables whose "
           "type has no destructor, keeping them visible in the debugger "
           "through the end of their lexical scope.">,
  ];
}

//===----------------------------------------------------------------------===//
// LowerLIT
//===----------------------------------------------------------------------===//

def LowerLIT : Pass<"lower-lit", "ModuleOp"> {
  let summary = "Lower the `lit` dialects to the `kgen` dialect.";
  let description = [{
    This pass performs lowers high level abstractions from "lit" to "kgen"
    and diagnoses any errors that are found along the way.
  }];

  let dependentDialects = [
    "KGENDialect",
    "HLCF::HLCFDialect",
    "POP::POPDialect"
  ];

  let options = [
    Option<"debugInfoLanguage", "debug-info-language",
           "llvm::dwarf::SourceLanguage", "llvm::dwarf::DW_LANG_Mojo",
           "The DWARF language to specify in the debug info, either `C` or "
           "`Mojo`. Defaults to `Mojo`.",
           "llvm::cl::values(clEnumValN(llvm::dwarf::DW_LANG_C, \"C\", \"C language.\"),"
           "clEnumValN(llvm::dwarf::DW_LANG_Mojo, \"Mojo\", \"Mojo language\"))">,
  ];
}

//===----------------------------------------------------------------------===//
// LowerClosures
//===----------------------------------------------------------------------===//

def LowerClosures : Pass<"lower-closures", "ModuleOp"> {
  let summary = "Lower `async` functions and closures.";
  let description = [{
    The `lower-closures` pass transforms `async` functions into normal
    `kgen.func` by adding the required POP-level coroutine machinery, and it
    lowers inline closure operations like `co.execute` and
    `kgen.stage_closure` by lifting their regions into top-level functions.
  }];

  let dependentDialects = ["POPDialect"];
}

//===----------------------------------------------------------------------===//
// LowerAsyncFunctions
//===----------------------------------------------------------------------===//

def LowerAsyncFunctions : Pass<"lower-async-functions", "ModuleOp"> {
  let summary = "Lower `async` functions and closures.";
  let description = [{
    The `lower-async-functions` pass transforms `async` functions into normal
    `kgen.func` by generating the ramp function and the resume function.
    Calls to the async function are lowered to calls to the ramp function.

     All CO ops except for suspension points are lowered in this pass.
  }];

  let dependentDialects = [
    "POPDialect",
    "KGENDialect",
    "mlir::index::IndexDialect",
    "mlir::ub::UBDialect",
  ];
}

//===----------------------------------------------------------------------===//
// OutlineClosures
//===----------------------------------------------------------------------===//

def OutlineClosures : Pass<"outline-closures", "ModuleOp"> {
  let summary = "Outlines region parameters into explicit closures.";
  let description = [{
    This pass outlines region parameters into functions that are called with
    a struct that contains all captures.
  }];

  let dependentDialects = ["KGENDialect", "POP::POPDialect"];

  let options = [
    Option<"debugBuild", "debug-build", "bool", "false",
           "Whether to check locations for parameter uses.">
  ];
}

//===----------------------------------------------------------------------===//
// LowerKGENToLLVM
//===----------------------------------------------------------------------===//

def LowerKGENToLLVM : Pass<"lower-kgen-to-llvm", "ModuleOp"> {
  let summary = "Lower the `kgen` dialect to the `llvm` dialect.";
  let description = [{
    This pass performs a conversion from the fully-elaborated and specified
    `kgen.func` ops and kgen types to the corresponding LLVM-dialect
    structures/types/ops.

    Functions marked as exported are marked as external. All other functions are
    marked as internal linkage. For exported functions, wrapper functions are
    generated with C-compatible calling conventions. This breaks up argument and
    results structs in-place and converts arrays to be pass-by-reference.

    For example, consider the following function that accepts and returns a
    buffer:

    ```mlir
    llvm.func @slice(%a: !llvm.struct<(i64, ptr<f32>)>, %i: !llvm.ptr<i64>)
        -> !llvm.struct<(i64, ptr<f32>)>
    ```

    The resulting wrapper's signature will be:

    ```mlir
    llvm.func @slice_c(%a_0: i64, %a_1: !llvm.ptr<f32>, %i: !llvm.ptr<i64>,
                     %res_0: !llvm.ptr<i64>, %res_1: !llvm.ptr<ptr<f32>)
    ```
  }];

  // We generate the LLVM dialect.
  let dependentDialects = [
    "MDialect",
    "mlir::LLVM::LLVMDialect",
    "mlir::NVVM::NVVMDialect",
    "mlir::ROCDL::ROCDLDialect",
    "mlir::index::IndexDialect",
    "mlir::ub::UBDialect",
    "DebugInfo::DebugInfoDialect"
  ];

  let options = [
    Option<"globalCtorFnName", "global-ctor-fn-name", "std::string",
           "\"kgenGlobalCtor\"",
           "The name of the global init function in JIT mode.">,
    Option<"globalDtorFnName", "global-dtor-fn-name", "std::string",
           "\"kgenGlobalDtor\"",
           "The name of the global deinit function in JIT mode.">,
  ];
}

//===----------------------------------------------------------------------===//
// LowerSuspensionPoints
//===----------------------------------------------------------------------===//

def LowerSuspensionPoints : Pass<"lower-suspension-points",
                                 "mlir::LLVM::LLVMFuncOp"> {
  let summary = "Lower suspension points in resume functions";
  let description = [{
    Lower away the suspension points into a state machine.
  }];
  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// TargetSpecificLLVMLowering
//===----------------------------------------------------------------------===//

def TargetSpecificLLVMLowering
    : Pass<"target-specific-llvm-lowering", "mlir::ModuleOp"> {
  let summary = "Apply target-contributed late MLIR passes on LLVM-dialect IR.";
  let description = [{
    Lets each target attach additional MLIR passes that modify the
    LLVM-dialect representation *before* it is translated to LLVM IR by
    `mlir::translateModuleToLLVMIR`. The pass itself is target-agnostic: it
    resolves the module's `TargetLowering` from `TargetLoweringRegistry`
    (dispatched by the module's target triple) and runs that target's
    `addPostLowerToLLVMPasses` late passes on a nested `PassManager`. A
    compiler plugin is one such target: its late passes are contributed the
    same way.

    Slots into `buildLowerToLLVMPipeline` after canonicalize/CSE and before
    `DebugInfoToLLVM` — the last opportunity to mutate the LLVM dialect
    while it is still MLIR. It is a no-op on triples that no target lowering
    claims (or whose target contributes no late passes).
  }];
  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// LegalizePOPOperations
//===----------------------------------------------------------------------===//

def LegalizePOPOperations : Pass<"legalize-pop-operations"> {
  let summary = "Legalize `pop` operations";
  let description = [{
    This pass performs a legalization of `pop` operations that are not supported
    by the LLVM Dialect. Primarily, it converts operation's operands to the type
    that can be used to execute the operation and result is converted back to
    the original type.

    For example:

    ```mlir
    %res = pop.add %a, %b : !kgen.scalar<f8e4m3fn>
    ```

    will be legalized to:

    ```mlir
    %a_f32 = pop.cast %a : !kgen.scalar<f8e4m3fn> to !kgen.scalar<f32>
    %b_f32 = pop.cast %b : !kgen.scalar<f8e4m3fn> to !kgen.scalar<f32>
    %res_f32 = pop.add %a_f32, %b_f32 : !kgen.scalar<f32>
    %res = pop.cast %res_f32 : !kgen.scalar<f32> to !kgen.scalar<f8e4m3fn>
    ```
  }];

  let dependentDialects = ["POP::POPDialect"];
}

//===----------------------------------------------------------------------===//
// LowerPOPToLLVM
//===----------------------------------------------------------------------===//

def LowerPOPToLLVM : Pass<"lower-pop-to-llvm"> {
  let summary = "Lower the `pop` dialect to the `llvm` dialect.";
  let description = [{
    This pass performs a conversion of fully-elaborated and specified `pop`
    dialect operations to LLVM dialect operations.
  }];

  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// UpdateMaterialization
//===----------------------------------------------------------------------===//

def UpdateMaterialization : Pass<"update-materialization"> {
  let summary = "Adjust materialized comptime values for their runtime home.";
  let description = [{
    Elaboration emits comptime values as `kgen.param.materialize`. A value can
    describe itself in terms that hold only inside the interpreter, and needs
    adjusting once it has a runtime home. This pass collects those adjustments.

    Resolve self-referential materialize: a value holding a pointer into the
    interpreter storage it was built in -- a struct with a small buffer plus a
    pointer to that buffer, for instance -- records that pointer as a reference
    to the storage. Where the value is stored to a known destination, the
    reference is dropped and the pointer written relative to that destination,
    so it refers to the materialized object.

    This runs before `SROA`/`Mem2Reg`: until the pointers refer to the
    destination, the destination's address does not appear to escape and the
    object can be scalarized out from under them.
  }];

  let dependentDialects = ["POP::POPDialect", "mlir::index::IndexDialect"];
}

//===----------------------------------------------------------------------===//
// SetFastMathFlags
//===----------------------------------------------------------------------===//

def SetFastMathFlags : Pass<"set-fastmath"> {
  let summary = "Apply the `-fp-mode` fast-math policy to POP operations.";
  let description = [{
    Implements the `-fp-mode` compiler option. The FP arithmetic ops
    (`pop.mul`/`add`/`sub`) enable FP contraction by default (their `contract`
    flag lets `a + b*c` fuse into an FMA). When `contract` is false the flag is
    cleared on every operation taking fastmath flags, so no value-changing
    contraction happens.
  }];

  let options = [
    Option<"contract", "contract", "bool", "true",
           "Keep FP contraction (fuse `a + b*c` into an FMA).">,
  ];

  let dependentDialects = ["POP::POPDialect"];
}

//===----------------------------------------------------------------------===//
// LowerGlobalPOPToLLVM
//===----------------------------------------------------------------------===//

def LowerGlobalPOPToLLVM : Pass<"lower-global-pop-to-llvm", "ModuleOp"> {
  let summary = "Lower global `pop` dialect operations to the `llvm` dialect.";
  let description = [{
    This module pass lowers `pop` operations that have global implications,
    and thus their lowering pass needs to run on the whole module. These are
    external calls and glboal constant operations.

    The pass converts `pop.aligned_alloc` and `pop.aligned_free` operations to
    calls to allocate and free functions to `KGEN_CompilerRT_AlignedAlloc` and
    `KGEN_CompilerRT_AlignedFree`. The pass will use functions present in the
    current module if possible, otherwise it will create declarations for
    external functions. The signatures must be:

    ```
    void *KGEN_CompilerRT_AlignedAlloc(ssize_t align, ssize_t size);
    void KGEN_CompilerRT_AlignedFree(void *ptr);
    ```
  }];

  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// LowerControlFlow
//===----------------------------------------------------------------------===//

def LowerControlFlow : Pass<"lower-control-flow"> {
  let summary = "Lower structured control flow to LLVM and CFGs.";
  let description = [{
    This pass converts structured control-flow operations to LLVM operations and
    control-flow graph regions. Because this pass generates CFG regions, it must
    run after `lower-kgen-to-llvm`, which lowers `kgen.func` to `llvm.func`.
  }];

  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// FunctionStats
//===----------------------------------------------------------------------===//

def ReorderParamOps: Pass<"reorder-param-ops", "ModuleOp"> {
  let summary = "Reorder Param Operations.";
  let description = [{
    The `reorder-param-ops` pass reorders parameter operations to ensure that
    parameter declarations are always before they are used, and parameter
    assertions always trigger as early as possible.
  }];

  let dependentDialects = [
    "MDialect",
    "KGENDialect",
  ];
}


//===----------------------------------------------------------------------===//
// ElaborateGenerators
//===----------------------------------------------------------------------===//

def ElaborateGenerators : Pass<"elaborate-generators", "ModuleOp"> {
  let summary = "elaborate generators into fully concrete funcs";
  let description = [{
    This pass performs the elaboration step for the kgen pipeline,
    converting generators and generator interfaces into concrete
    funcs.
  }];

  // FIXME(#15949): Should not require all these dialects to be loaded.
  let dependentDialects = [
    "KGENDialect",
    "DebugInfo::DebugInfoDialect",
    "HLCF::HLCFDialect",
    "MDialect",
    "mlir::LLVM::LLVMDialect",
    "mlir::NVVM::NVVMDialect",
    "mlir::ROCDL::ROCDLDialect",
    "mlir::index::IndexDialect",
    "mlir::ub::UBDialect",
  ];

  let options = [
    Option<"maxDepth", "max-depth", "unsigned",
           "std::numeric_limits<unsigned>::max()",
           "The maximum elaborator instantiation depth.">,
    Option<"elaborateDebugInfo", "elaborate-debuginfo", "bool", "false",
           "If true, parameter references in debuginfo will be concretized.">,
    Option<"optimizeInterpreter", "optimize-interpret", "bool", "false",
           "Whether to optimize interpreter functions.">,
    Option<"useParametricInterpreter", "use-parametric-interpret",
           "bool", "false",
           "If true, use interpreter that interprets parametric functions.">,
    Option<"errorIncludePrelude", "error-include-prelude",
           "bool", "false",
           "If true, elaboration error will include prelude locations "
           "from mojo _startup modules.">,
    Option<"errorVerbose", "error-verbose",
           "CompilationOptions::ErrorVerboseLevel",
           "CompilationOptions::kSimpleParams",
           "CompilationOptions::kNoParams: "
           "don't include any concrete parameter values; "
           "CompilationOptions::kSimpleParams: "
           "elaboration error will include concretized "
           "parameter values at call expansion site which are of simple types;"
           "CompilationOptions::kAllParams: "
           "elaboration error will include all concretized "
           "parameter values as mlir attributes at call expansion site "
           "instead of just values with simple types.",
           "cl::values(clEnumValN(CompilationOptions::kNoParams, \"no-params\","
              "\"show no concrete parameter values\"),"
            "clEnumValN(CompilationOptions::kSimpleParams, \"simple-params\","
              "\"show only simple concrete parameter values "
              "(string, integer, float, boolean) \"),"
            "clEnumValN(CompilationOptions::kAllParams, \"all-params\","
              "\"show all concrete parameter values\"))">,
    Option<"loopUnrollingWarnThreshold", "loop-unrolling-warn-threshold",
           "unsigned", "65536",
           "Threshold to warn if a loop is unrolled for too many times, "
           "default value is 65536, set to 0 to disable the warning.">
  ];
}

//===----------------------------------------------------------------------===//
// InlineParametric
//===----------------------------------------------------------------------===//

def InlineParametric : Pass<"inline-param", "ModuleOp"> {
  let summary = "Process concrete 'always_inline' operations and heuristics";
  let description = [{
    The `inline-param` pass will process all concrete calls to
    'always_inline' generators and inline them. This pass also uses
    a heuristic to automatic inline concrete calls. If a cycle is encountered
    during inlining, the pass emits an error and fails to inline the cycle.
    This pass will strip debug info as appropriate for functions marked
    'always_inline(nodebug)'. This pass can only run on parametric KGEN IR.
  }];

  let dependentDialects = [
    "MDialect",
    "HLCF::HLCFDialect",
  ];

  let options = [
    Option<"nodebugOnly", "nodebug-only", "bool", "false",
           "If true, only `always_inline_no_debug` functions are inlined.">,
    Option<"optimizationLevel", "optimization-level", "unsigned", "1",
           "Specify the compilation optimization level.">,
    Option<"updateDebugInfo", "update-debug-info", "bool", "true",
           "If true, debug info of inlined functions are updated accordingly.">
  ];
}

//===----------------------------------------------------------------------===//
// ApplyInliner
//===----------------------------------------------------------------------===//

def ApplyInliner : Pass<"apply-inliner", "ModuleOp"> {
  let summary = "Inline trivial 'apply' operators in parameter expressions.";
  let description = [{
    The `apply-inline` pass processes `apply` operators on trivial functions, by
    certain definitions of trivial. This could be, for example, simplify
    parameter calls to functions that just return an argument or a constant. The
    primary goal of this pass is to simplify parameter expressions in the IR.
  }];
}

