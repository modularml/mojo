//
// This defines operation interfaces in the LIT dialect.
//
//===----------------------------------------------------------------------===//

#ifndef KGEN_LITDIALECT_LITDECLINTERFACE_TD
#define KGEN_LITDIALECT_LITDECLINTERFACE_TD

include "mlir/IR/OpBase.td"

def ASTDeclInterface : OpInterface<"ASTDeclInterface"> {
  let description = [{
    This interface represents an operation that corresponds to an ASTDecl,
    generally corresponding to a declaration in the Mojo source language. For
    example, functions, variables, structs, etc.
  }];
  let cppNamespace = "::M::KGEN::LIT";

  let methods = [
    InterfaceMethod<[{
      Return the name of this decl.
    }], "StringAttr", "getDeclName", (ins), [{}], [{
      return $_op.getNameAttr();
    }]>,

    InterfaceMethod<[{
      Return if this decl is synthetic or not. A decl is synthetic if it
      is generated by the compiler and does not have a corresponding decl
      in the source code.
    }], "bool", "isSynthetic", (ins), [{}], [{
      return false;
    }]>,

    InterfaceMethod<[{
      Return the documentation string attached to this decl, or nullptr if the
      decl has no documentation attached.
    }], "DocStringAttr", "getDocStringAttr", (ins), [{}], [{
      return DocStringAttr();
    }]>,

    InterfaceMethod<[{
      Set the documentation string for this decl. By default, this method is not
      valid to call on an operation without a doc string.
    }], "void", "setDocStringAttr", (ins "DocStringAttr":$docString), [{}], [{
      llvm_unreachable("TODO: decl does not support a doc string");
    }]>,

    InterfaceMethod<[{
      Clear the documentation string for this decl.
    }], "Attribute", "removeDocStringAttr", (ins), [{}], [{
      return Attribute();
    }]>,

    InterfaceMethod<[{
      Set the decorators on this operation.
    }], "void", "setDecoratorsAttr", (ins "DecoratorsAttr":$decorators), [{}], [{
      llvm_unreachable("TODO: decl does not support decorators");
    }]>,
  ];
}

//===----------------------------------------------------------------------===//
// StabilityDecoratorInterface
//===----------------------------------------------------------------------===//

def StabilityDecoratorInterface : OpInterface<"StabilityDecoratorInterface",
                                              [ASTDeclInterface]> {
  let description = [{
    This interface represents an operation that can have @stable, @deprecated,
    and @unavailable decorators. The @stable decorator indicates that the API
    is considered stable and will not change in backward-incompatible ways
    except in major releases. The @deprecated decorator indicates that the API
    should no longer be used (warning at use sites). The @unavailable decorator
    indicates that the API is intentionally not provided and any reference is
    an error. These decorators are mutually exclusive.

    This interface inherits from ASTDeclInterface since all declarations that
    support stability decorators also have names accessible via getDeclName().
  }];
  let cppNamespace = "::M::KGEN::LIT";

  let methods = [
    InterfaceMethod<[{
      Return whether this decl has an @stable decorator.
    }], "bool", "getHasStableDecorator", (ins)>,

    InterfaceMethod<[{
      Set whether this decl has an @stable decorator.
    }], "void", "setHasStableDecorator", (ins "bool":$stable)>,

    InterfaceMethod<[{
      Return the deprecation info attribute if this decl has an @deprecated
      decorator, or nullptr if not deprecated.
    }], "DeprecationInfoAttr", "getDeprecationInfoAttr", (ins)>,

    InterfaceMethod<[{
      Set the deprecation info attribute for this decl.
    }], "void", "setDeprecationInfoAttr", (ins "DeprecationInfoAttr":$deprecation)>,

    InterfaceMethod<[{
      Return the unavailable info attribute if this decl has an @unavailable
      decorator, or nullptr if not unavailable.
    }], "UnavailableInfoAttr", "getUnavailableInfoAttr", (ins)>,

    InterfaceMethod<[{
      Set the unavailable info attribute for this decl.
    }], "void", "setUnavailableInfoAttr", (ins "UnavailableInfoAttr":$unavailable)>,

    InterfaceMethod<[{
      Return the 'since' version string attribute if this decl has an
      @stable(since="version") decorator, or nullptr if not specified.
    }], "StringAttr", "getStableSinceVersionAttr", (ins)>,

    InterfaceMethod<[{
      Set the 'since' version string attribute for this decl.
    }], "void", "setStableSinceVersionAttr", (ins "StringAttr":$version)>,
  ];

  let extraSharedClassDeclaration = [{
    /// Returns true if the declaration is marked stable.
    bool isStable() { return $_op.getHasStableDecorator(); }

    /// Returns true if the declaration is marked deprecated.
    bool isDeprecated() { return $_op.getDeprecationInfoAttr() != nullptr; }

    /// Returns true if the declaration is marked unavailable.
    bool isUnavailable() { return $_op.getUnavailableInfoAttr() != nullptr; }

    /// Returns the deprecation warning message, or nullptr if not deprecated.
    StringAttr getDeprecationWarningAttr() {
      if (auto info = $_op.getDeprecationInfoAttr())
        return info.getWarning();
      return nullptr;
    }

    /// Returns the deprecation replacement identifier, or nullptr if not specified.
    StringAttr getDeprecationReplacementAttr() {
      if (auto info = $_op.getDeprecationInfoAttr())
        return info.getReplacement();
      return nullptr;
    }

    /// Returns the unavailable reason message, or nullptr if not unavailable.
    StringAttr getUnavailableReasonAttr() {
      if (auto info = $_op.getUnavailableInfoAttr())
        return info.getReason();
      return nullptr;
    }

    /// Returns the unavailable replacement identifier, or nullptr if not specified.
    StringAttr getUnavailableReplacementAttr() {
      if (auto info = $_op.getUnavailableInfoAttr())
        return info.getReplacement();
      return nullptr;
    }

    /// Returns the 'since' version string, or empty string if not specified.
    StringRef getSinceVersion() {
      if (auto v = $_op.getStableSinceVersionAttr())
        return v.getValue();
      return {};
    }
  }];
}

#endif // KGEN_LITDIALECT_LITDECLINTERFACE_TD
