load("//bazel:api.bzl", "driver_option_tablegen", "modular_cc_binary", "modular_cc_library", "pkg_files", "td_library")

package(default_visibility = ["//Mojo:consumers"])

[
    driver_option_tablegen(
        name = command,
        srcs = glob(["{}/*.td".format(command)]),
        manual_name = "mojo-{}".format(command.lower()),
        markdown_name = command.lower(),
        td_file = "{command}/{command}Options.td".format(command = command),
        deps = [
            ":MojoDescriptionTdFiles",
        ],
    )
    for command in [
        "Build",
        "Debug",
        "Demangle",
        "Doc",
        "Format",
        "Precompile",
        "REPL",
        "Run",
    ]
]

# A thin wrapper around Doc.inc_files that adds includes = ["."] so that
# external tools (e.g. kgen-doc) can access the generated option headers via
# short paths like "Doc/DocOptions.inc" rather than the full workspace-root
# path.
modular_cc_library(
    name = "DocIncFiles",
    includes = ["."],
    deps = [":Doc.inc_files"],
)

td_library(
    name = "MojoDescriptionTdFiles",
    srcs = glob([
        "*.td",
        "Common/*.td",
    ]),
    includes = ["."],
    deps = [
        "//Support:DriverCommandTdFiles",
        "//Support:OptTableTdFiles",
    ],
)

driver_option_tablegen(
    name = "Index",
    srcs = ["DriverOptions.td"],
    includes = ["."],
    manual_name = "mojo",
    markdown_name = "index",
    td_file = "DriverOptions.td",
    deps = [
        ":Build.td_library",
        ":Debug.td_library",
        ":Demangle.td_library",
        ":Doc.td_library",
        ":Format.td_library",
        ":MojoDescriptionTdFiles",
        ":Precompile.td_library",
        ":REPL.td_library",
        ":Run.td_library",
    ],
)

pkg_files(
    name = "docs",
    srcs = [
        ":Build.man_files",
        ":Debug.man_files",
        ":Demangle.man_files",
        ":Doc.man_files",
        ":Format.man_files",
        ":Index.man_files",
        ":Precompile.man_files",
        ":REPL.man_files",
        ":Run.man_files",
    ],
)

_MOJO_LINKOPTS = select({
    "@platforms//os:linux": [
        "-Wl,--export-dynamic-symbol=__jit_debug_*",
        "-Wl,--export-dynamic-symbol=mlir*",
    ],
    "//conditions:default": [],
})

modular_cc_library(
    name = "mojo_common",
    srcs = glob(["**/*.cpp"]),
    hdrs = glob(["**/*.h"]),
    includes = ["."],
    internal_deps = select({
        # Under --config=hal-device-context we don't link the full DeviceContext,
        # but we need CompilationDevice and the HAL-only CompilerDeviceArch.
        "//:hal_device_context_enabled": [
            "//MLRT:Driver/CompilationDeviceImpl",
            "//MLRT:Driver/CompilerDeviceArch",
        ],
        "//conditions:default": [],
    }),
    local_defines = ["MOJO_COMPILER_ACCELERATOR_SUPPORT=1"],
    strip_include_prefix = "",
    deps = [
        ":Build.inc_files",
        ":Debug.inc_files",
        ":Demangle.inc_files",
        ":Doc.inc_files",
        ":Format.inc_files",
        ":Index.inc_files",
        ":Precompile.inc_files",
        ":REPL.inc_files",
        ":Run.inc_files",
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals",
        "//Config",
        "//Init",
        "//Mojo:Compiler",
        "//Mojo:DialectChecksum",
        "//Mojo:ExecutionEngine",
        "//Mojo:KGENDialect",
        "//Mojo:LITDialect",
        "//Mojo:MojoParser",
        "//Mojo:MojoTooling",
        "//Mojo:ObjectCompiler",
        "//Mojo:POPDialect",
        "//Mojo:Support",
        "//Mojo:SupportForceLinkMLIRC",
        "//Mojo:TargetBackend.headers",
        "//Mojo:TargetTraits",
        "//Mojo:ToolCommon",
        "//Support:Base",
        "//Support:BazelRunfiles",
        "//Support:Compiler",
        "//Support:CrashReporting",
        "//Support:DebugInfoDialect",
        "//Support:Driver",
        "//Support:Filesystem",
        "//Support:Globals",
        "//Support:MArchTarget",
        "//Support:MDialect",
        "@llvm-project//mlir:IndexDialect",
    ],
)

modular_cc_binary(
    name = "mojo",
    linkopts = _MOJO_LINKOPTS,
    deps = [":mojo_common"],
)

modular_cc_binary(
    name = "mojo-full",
    data = [
        "//Mojo:MojoLLDB",
        "//Mojo:gdb-server",
        "//Mojo:mojo-lldb",
        "//Mojo/tools/mojo-repl-entry-point",
        "@llvm-project//lldb:lldb-argdumper",
        "@llvm-project//llvm:llvm-symbolizer",
    ],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "0",
    },
    linkopts = _MOJO_LINKOPTS,
    mojo_deps = ["@mojo//:std"],
    tags = ["manual"],
    deps = [":mojo_common"],
)
