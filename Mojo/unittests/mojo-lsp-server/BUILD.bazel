load("//bazel:api.bzl", "modular_cc_library", "modular_cc_test", "modular_python_binding_library_test")

package(default_visibility = ["//visibility:private"])

modular_cc_library(
    name = "Support",
    testonly = True,
    srcs = glob(["Support.*"]),
    deps = [
        "//Mojo/tools/mojo-lsp-server",
        "//Mojo/tools/mojo-lsp-test-client",
        "@llvm-project//third-party/unittest:gtest",
    ],
)

# Unit test for DocumentDebouncer - doesn't need LSP server infrastructure.
modular_cc_test(
    name = "DocumentDebouncerTest",
    srcs = ["DocumentDebouncerTest.cpp"],
    deps = [
        "//Mojo/tools/mojo-lsp-server",
        "@llvm-project//llvm:Support",
    ],
)

# Some tests are very slow, because of which we split all the tests among
# different test targets to allow parallel execution.
# You can execute all of them with
#    bt //Mojo/unittests/mojo-lsp-server/...

[
    modular_cc_test(
        name = src,
        srcs = [src + ".cpp"],
        data = glob([
            "inputs/*.mojo",
            "inputs_with_package/*.mojo",
        ]) + [
            "//Mojo/tools/mojo-lsp-server",
        ],
        env = {
            "MODULAR_PATH": ".",
            "PRESERVE_LSP_IO_FILES": "1",
            "PYTHONHOME": "/dev/null",  # Make sure python tests are added below instead
        },
        mojo_deps = [
            "@mojo//:std",
        ],
        deps = [
            ":Support",
        ],
    )
    for src in [
        "CodeActionTest",
        "CodeBlockTest",
        "FoldingRangeTest",
        "InitFileTest",
        "RegressionTest",
        "SampleTest",
        "SemanticTokensTest",
        "SignatureHelpTest",
    ]
]

modular_python_binding_library_test(
    name = "PythonTests",
    srcs = [
        "MOGGAnnotateDiags.cpp",
        "NotebookTest.cpp",
    ],
    data = [
        "//Mojo/tools/mojo-lsp-server",
    ],
    env = {
        "MODULAR_PATH": ".",
        "PRESERVE_LSP_IO_FILES": "1",
    },
    mojo_deps = [
        "@mojo//:std",
    ],
    deps = [
        ":Support",
    ],
)
