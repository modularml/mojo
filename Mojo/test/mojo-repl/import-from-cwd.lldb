# RUN: %repl <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

# The REPL has no main file, so module lookup falls back to the process's
# working directory; the directory itself, not its parent. `cwd_package` exists
# only inside Inputs, so this import succeeding proves the CWD is on the search
# path.

%cd ./Inputs

from cwd_package import package_function

# CHECK: package_function was called
package_function()
