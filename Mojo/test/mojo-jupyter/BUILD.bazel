load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "mojo-jupyter",
    # TODO(MOTO-1544): test_completion_incremental.test is excluded from srcs
    # until the sporadic crash in CompletionCache on m7g (aarch64 Graviton) is
    # fixed. Kept in data so the linter sees it as referenced. To re-enable,
    # move it back into the srcs glob and remove it from data.
    srcs = glob(
        ["**/*.test"],
        exclude = ["test_completion_incremental.test"],
    ),
    custom_substitutions = {
        "%mojo_jupyter_executor": "$(rlocationpath //Mojo/tools/mojo-jupyter-executor) --lldb-init-file $(rlocationpath //Mojo/unittests:lit-lldb-init.in)",
    },
    data = glob([
        "*.ipynb",
        "*.mojo",
    ]) + [
        # TODO(MOTO-1544): kept here (not srcs) so the file is referenced.
        "test_completion_incremental.test",
        "@mojo//:std_srcs",
        "//Mojo/unittests:lit-lldb-init.in",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations @mojo//:std_srcs)",
    },
    force_strip = True,  # TODO(MOTO-1190): Debug and fix this duplicate symbol issue
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//:ubsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//Mojo/tools/mojo-jupyter-executor",
    ],
)
