load("//bazel:api.bzl", "lit_tests", "modular_cc_library")

package(default_visibility = ["//visibility:private"])

# C reference implementations for struct ABI testing.
# These demonstrate correct C ABI behavior for various struct sizes.
modular_cc_library(
    name = "c_abi_reference",
    testonly = True,
    srcs = glob(["*.c"]),
    copts = [
        "-Werror",
        "-O0",  # No optimization to make assembly easier to inspect
        "-g",
    ],
    alwayslink = True,  # Ensure all symbols are available for external_call
)

# Mojo integration tests for C ABI
# These tests call C functions and validate struct passing/return values
lit_tests(
    name = "test",
    srcs = glob(["*.mojo"]),
    data = [":c_abi_reference"],
    mojo_deps = ["@mojo//:std"],
    tools = ["//Mojo/tools/mojo"],
)
