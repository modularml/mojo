diff --git a/mojo/mojo_library.bzl b/mojo/mojo_library.bzl
index 9468b24..99dbbeb 100644
--- a/mojo/mojo_library.bzl
+++ b/mojo/mojo_library.bzl
@@ -21,6 +21,26 @@ def _mojo_library_implementation(ctx):
     mojo_toolchain = ctx.toolchains["//:toolchain_type"].mojo_toolchain_info
     build_env = getattr(ctx.toolchains["//:toolchain_type"], "build_env", {})
 
+    # A child rule may supply a different compiler to invoke, without being
+    # reconfigured itself: an attribute transition on `_mojo_override` moves only
+    # the compiler's own subgraph, leaving this target and its deps -- and so
+    # the cc libraries it propagates -- in the incoming configuration.
+    override = getattr(ctx.attr, "_mojo_override", None)
+    override_exe = getattr(ctx.executable, "_mojo_override", None)
+
+    # ctx.attr exposes an attribute carrying a transition as a one-element list,
+    # while ctx.executable still resolves to the single File.
+    if type(override) == "list":
+        override = override[0] if override else None
+
+    mojo = override_exe or mojo_toolchain.mojo
+    mojo_tools = mojo_toolchain.all_tools
+    if override:
+        mojo_tools = mojo_tools + [
+            override[DefaultInfo].default_runfiles.files,
+            override[DefaultInfo].files,
+        ]
+
     mojo_precmp_file = ctx.actions.declare_file(ctx.label.name + ".mojoc")
     args = ctx.actions.args()
     args.add("precompile")
@@ -64,9 +84,9 @@ def _mojo_library_implementation(ctx):
     file_args.add_all(import_paths, map_each = format_import)
     file_args.add_all([ctx.files.srcs[0]], map_each = _format_root)
     ctx.actions.run(
-        executable = mojo_toolchain.mojo,
+        executable = mojo,
         inputs = depset(ctx.files.srcs + ctx.files.additional_compiler_inputs, transitive = [transitive_mojodeps]),
-        tools = mojo_toolchain.all_tools,
+        tools = mojo_tools,
         outputs = precompile_outputs,
         arguments = [args, file_args],
         mnemonic = "MojoPrecompile",
