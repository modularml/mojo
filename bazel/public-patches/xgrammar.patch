+std::string XMLToolCallingConverter::FormatXMLProperty(
+    const std::string& key_open,
+    const std::string& key_close,
+    const std::string& value_rule
+) const {
+  // Token-delimited markers frame the value with no surrounding whitespace
+  // (the model emits the XML wire form tightly); whitespace could bleed into
+  // a whitespace-sensitive value (e.g. `^\t$`) or fill an object value with
+  // blanks.
+  std::string whitespace = MarkerTokenId(kValueClose) >= 0 ? "" : GetWhitespacePattern();
+
+  std::string value_open;
+  std::string value_close;
+  if (!xml_wrapper_.value_wrapper_prefix.empty()) {
+    value_open = EmitMarker(kValueOpen, xml_wrapper_.value_wrapper_prefix);
+    value_close = EmitMarker(kValueClose, xml_wrapper_.parameter_suffix);
+  } else if (!xml_wrapper_.key_is_tag) {
+    // Bare value with no separate value-wrap: still needs a value-close marker
+    // to terminate it, unless the key's own close is the value close (tag-key
+    // styles, where key_is_tag means CloseTag IS the value close).
+    value_close = EmitMarker(kValueClose, xml_wrapper_.parameter_suffix);
+  }
+
+  std::string result = key_open;
+  if (!value_open.empty()) {
+    result += " " + whitespace + " " + value_open;
+  }
+  result += " " + whitespace + " " + value_rule;
+  if (!value_close.empty()) {
+    result += " " + whitespace + " " + value_close;
+  }
+  if (!key_close.empty()) {
+    result += " " + whitespace + " " + key_close;
+  }
+  return result;
+}
