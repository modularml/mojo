+// stays text. False when a "~" carries anything else, which no pointer does.
+static bool DecodePointerToken(std::string* token) {
+  std::string decoded;
+  decoded.reserve(token->size());
+  for (size_t i = 0; i < token->size(); ++i) {
+    if ((*token)[i] != '~') {
+      decoded += (*token)[i];
+      continue;
+    }
+    if (i + 1 >= token->size()) return false;
+    const char escaped = (*token)[++i];
+    if (escaped == '0') {
+      decoded += '~';
+    } else if (escaped == '1') {
+      decoded += '/';
+    } else {
+      return false;
+    }
+  }
+  *token = std::move(decoded);
+  return true;
