+std::string JSONSchemaConverter::GenerateStringLengthBody(
+    int min_length, int max_length, const GenerationContext& ctx
+) const {
+  if (ctx.pattern) {
+    int min = std::max(0, min_length - 1);
+    int max = max_length == -1 ? -1 : max_length - 1;
+    if (!ctx.allow_empty && max_length != -1 && max < min) {
+      XGRAMMAR_LOG(FATAL) << "maxLength admits only the empty string, which an "
+                             "alphabet-constrained string cannot represent";
+    }
+    const std::string prefix =
+        "[" + ctx.pattern->first_body + "] [" + ctx.pattern->rest_body + "]{";
+    if (max == -1) {
+      return prefix + std::to_string(min) + ",}";
+    }
+    return prefix + std::to_string(min) + "," + std::to_string(max) + "}";
+  }
+  const std::string char_class = ctx.framing == GenerationContext::Framing::kTokenDelimited
+                                     ? "[^" + StringPatternForbiddenChars(ctx) + "]"
+                                     : "[^\"\\\\\\r\\n]";
+  const std::string repetition = max_length == -1
+                                     ? "{" + std::to_string(min_length) + ",}"
+                                     : "{" + std::to_string(min_length) + "," +
+                                           std::to_string(max_length) + "}";
+  return char_class + repetition;
+}
