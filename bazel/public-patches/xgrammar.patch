+  // The shortest match, over edges costing one character each and epsilons
+  // costing none.
+  constexpr int kUnreached = -1;
+  std::vector<int> shortest(num_states, kUnreached);
+  std::deque<int> frontier;
+  shortest[fsm.GetStart()] = 0;
+  frontier.push_back(fsm.GetStart());
+  while (!frontier.empty()) {
+    const int state = frontier.front();
+    frontier.pop_front();
+    for (const auto& edge : edges[state]) {
+      const int cost = edge.IsEpsilon() ? 0 : 1;
+      const int candidate = shortest[state] + cost;
+      if (shortest[edge.target] != kUnreached && shortest[edge.target] <= candidate) continue;
+      shortest[edge.target] = candidate;
+      if (cost == 0) {
+        frontier.push_front(edge.target);
+      } else {
+        frontier.push_back(edge.target);
+      }
+    }
+  }
+
+  std::optional<int> min_length;
+  for (int state = 0; state < num_states; ++state) {
+    if (!fsm.IsEndState(state) || shortest[state] == kUnreached) continue;
+    if (!min_length.has_value() || shortest[state] < *min_length) min_length = shortest[state];
+  }
+  // No end state is reachable, so the language is empty and has no length.
+  if (!min_length.has_value()) return std::nullopt;
+
+  // The longest match only concerns states the start reaches that can still
+  // reach an end; a cycle among those means the language has no upper bound.
+  std::vector<std::vector<int>> predecessors(num_states);
+  for (int state = 0; state < num_states; ++state) {
+    for (const auto& edge : edges[state]) predecessors[edge.target].push_back(state);
+  }
+  std::vector<bool> reaches_end(num_states, false);
+  std::vector<int> pending;
+  for (int state = 0; state < num_states; ++state) {
+    if (fsm.IsEndState(state)) {
+      reaches_end[state] = true;
+      pending.push_back(state);
+    }
+  }
+  while (!pending.empty()) {
+    const int state = pending.back();
+    pending.pop_back();
+    for (const int previous : predecessors[state]) {
+      if (reaches_end[previous]) continue;
+      reaches_end[previous] = true;
+      pending.push_back(previous);
+    }
+  }
+
+  std::vector<bool> useful(num_states, false);
+  int useful_count = 0;
+  for (int state = 0; state < num_states; ++state) {
+    useful[state] = shortest[state] != kUnreached && reaches_end[state];
+    if (useful[state]) ++useful_count;
+  }
+
+  std::vector<int> indegree(num_states, 0);
+  for (int state = 0; state < num_states; ++state) {
+    if (!useful[state]) continue;
+    for (const auto& edge : edges[state]) {
+      if (useful[edge.target]) ++indegree[edge.target];
+    }
+  }
+  std::vector<int> ordered;
+  ordered.reserve(useful_count);
+  for (int state = 0; state < num_states; ++state) {
+    if (useful[state] && indegree[state] == 0) ordered.push_back(state);
+  }
+  for (size_t i = 0; i < ordered.size(); ++i) {
+    for (const auto& edge : edges[ordered[i]]) {
+      if (!useful[edge.target]) continue;
+      if (--indegree[edge.target] == 0) ordered.push_back(edge.target);
+    }
+  }
+  // A cycle leaves states unordered. An epsilon-only cycle adds no character
+  // and is reported unbounded too, which refuses rather than under-constrains.
+  if (static_cast<int>(ordered.size()) < useful_count) return std::make_pair(*min_length, -1);
