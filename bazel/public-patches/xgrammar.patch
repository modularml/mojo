+std::string JSONSchemaConverter::RenderLiteral(
+    const picojson::value& v, const GenerationContext& value_ctx, const GenerationContext& key_ctx
+) const {
+  if (v.is<std::string>()) {
+    std::string json = v.serialize();
+    return WrapLiteral(json.substr(1, json.size() - 2), value_ctx);
+  }
+  if (v.is<picojson::array>()) {
+    const auto& arr = v.get<picojson::array>();
+    std::string body = "\"[\"";
+    for (size_t i = 0; i < arr.size(); ++i) {
+      body += (i == 0 ? std::string(" ") : " \"" + item_sep_ + "\" ") +
+              RenderLiteral(arr[i], value_ctx, key_ctx);
+    }
+    body += " \"]\"";
+    return "(" + body + ")";
+  }
+  if (v.is<picojson::object>()) {
+    const auto& obj = v.get<picojson::object>();
+    std::string body = "\"{\"";
+    bool first = true;
+    for (const auto& key : obj.ordered_keys()) {
+      std::string kjson = picojson::value(key).serialize();
+      body += (first ? std::string(" ") : " \"" + item_sep_ + "\" ") +
+              WrapLiteral(kjson.substr(1, kjson.size() - 2), key_ctx) + " \"" + colon_sep_ + "\" " +
+              RenderLiteral(obj.at(key), value_ctx, key_ctx);
+      first = false;
+    }
+    body += " \"}\"";
+    return "(" + body + ")";
+  }
+  return "\"" + v.serialize() + "\"";
+}
