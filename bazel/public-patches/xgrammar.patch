+  // The automaton consumes bytes; JSON Schema counts characters. One edge is one
+  // character only while the language stays inside ASCII, so a pattern that can
+  // leave it is unmeasurable here rather than measured in the wrong unit. An
+  // edge that is neither a character range nor an epsilon consumes an unknown
+  // number of characters, so it is unmeasurable too.
+  for (int state = 0; state < num_states; ++state) {
+    for (const auto& edge : edges[state]) {
+      if (edge.IsEpsilon()) continue;
+      if (!edge.IsCharRange() || edge.max > 127) return std::nullopt;
+    }
+  }
