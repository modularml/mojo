+  }
+  return "{" + std::to_string(min) + "," + std::to_string(max) + "}";
+}
+
+int XMLToolCallingConverter::MarkerTokenId(XMLMarker marker) const {
+  auto idx = static_cast<size_t>(marker);
+  if (idx < xml_marker_token_ids_.size()) {
+    return xml_marker_token_ids_[idx];
+  }
+  return -1;
+}
