+inline std::vector<std::pair<uint32_t, uint32_t>> ComplementCharRanges(
+    std::vector<std::pair<uint32_t, uint32_t>> ranges, uint32_t min, uint32_t max
+) {
+  std::sort(ranges.begin(), ranges.end());
+  std::vector<std::pair<uint32_t, uint32_t>> result;
+  uint32_t next = min;
+  for (const auto& [lo, hi] : ranges) {
+    if (lo > next) result.emplace_back(next, lo - 1);
+    if (hi + 1 > next) next = hi + 1;
+  }
+  if (next <= max) result.emplace_back(next, max);
+  return result;
+}
