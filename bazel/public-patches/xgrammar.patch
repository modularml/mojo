+          if (fsm.GetFsm().GetFsm().GetTokenEdgeInfo(edge.GetAuxIndex()).Contains(token_id)) {
+            accepted = true;
+            break;
+          }
+        } else if (edge.IsExcludeToken()) {
+          if (fsm.GetFsm().GetFsm().GetExcludeTokenEdgeInfo(edge.GetAuxIndex()).Accepts(token_id)) {
+            accepted = true;
+            break;
+          }
+        }
+      }
+      if (accepted) break;
+    }
+    if (accepted) next_token_bitset.Set(token_id, true);
+  }
