+std::pair<std::string, std::string> JSONSchemaConverter::StringDelimiters(const GenerationContext& ctx)
+    const {
+  switch (ctx.framing) {
+    case GenerationContext::Framing::kBare:
+      // An alphabet-constrained string carries no surrounding delimiters.
+      return {"", ""};
+    case GenerationContext::Framing::kTokenDelimited: {
+      const std::string delimiter = DelimiterTokenTerminal();
+      return {delimiter, delimiter};
+    }
+    case GenerationContext::Framing::kQuotedJSON:
+      return {"\"\\\"\"", "\"\\\"\""};
+  }
+  XGRAMMAR_UNREACHABLE();
+}
