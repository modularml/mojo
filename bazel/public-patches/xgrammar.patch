+  if (!RegexFSMBuilderSupportsLengthAnalysis(regex)) return std::nullopt;
+  auto built = RegexFSMBuilder::Build(regex, remaining_work);
+  if (built.IsErr()) return std::nullopt;
+  const FSMWithStartEnd fsm = std::move(built).Unwrap();
+  const auto& edges = fsm.GetFsm().GetEdges();
