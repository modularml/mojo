+std::string XMLToolCallingConverter::EmitMarker(
+    XMLMarker marker, const std::string& literal
+) const {
+  int id = MarkerTokenId(marker);
+  if (id >= 0) {
+    return TokenTerminal(id);
+  }
+  return "\"" + literal + "\"";
+}
