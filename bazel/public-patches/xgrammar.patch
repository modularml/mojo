+  constexpr int kNoPath = -1;
+  std::vector<int> longest(num_states, kNoPath);
+  longest[fsm.GetStart()] = 0;
+  for (const int state : ordered) {
+    if (longest[state] == kNoPath) continue;
+    for (const auto& edge : edges[state]) {
+      if (!useful[edge.target]) continue;
+      const int candidate = longest[state] + (edge.IsEpsilon() ? 0 : 1);
+      if (candidate > longest[edge.target]) longest[edge.target] = candidate;
+    }
+  }
+  int max_length = 0;
+  for (int state = 0; state < num_states; ++state) {
+    if (fsm.IsEndState(state) && longest[state] > max_length) max_length = longest[state];
+  }
+  return std::make_pair(*min_length, max_length);
+}
